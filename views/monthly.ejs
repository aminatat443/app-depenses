<%- include('partials/page-start', {
  pageTitle: 'Bilans & statistiques',
  pageDescription: 'Comparez les dépenses du foyer par mois et par catégorie.',
  activePage: 'monthly'
}) %>

<section class="page-toolbar">
  <div><h2>Bilan de <%= monthLabel %></h2><p>Compte boutique et dépenses ordinaires réunis.</p></div>
  <button class="button button-primary" type="button" data-modal-template="monthly-export"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4"/><path d="M5 16v4h14v-4"/></svg> Exporter en Excel</button>
</section>

<section class="panel-card page-filter-card">
  <form method="GET" action="/monthly" class="page-filter-form" data-live-filter data-live-filter-root=".page-content">
    <label>Mois
      <select name="month">
        <% for (let monthNumber = 1; monthNumber <= 12; monthNumber += 1) { %>
          <option value="<%= monthNumber %>" <%= monthNumber === month ? 'selected' : '' %>><%= new Date(Date.UTC(year, monthNumber - 1, 1)).toLocaleString('fr-FR', { month: 'long', timeZone: 'UTC' }) %></option>
        <% } %>
      </select>
    </label>
    <label>Année
      <input type="number" name="year" min="2000" max="2100" value="<%= year %>" />
    </label>
    <button class="button button-subtle" type="submit">Afficher le bilan</button>
  </form>
</section>

<section class="summary-grid report-summary">
  <article class="metric-card"><div class="metric-heading"><span>Compte boutique</span></div><div class="metric-value"><%= formatCurrency(totalGroceries) %></div><div class="metric-foot"><span>Ravitaillements du mois</span></div></article>
  <article class="metric-card"><div class="metric-heading"><span>Autres dépenses</span></div><div class="metric-value"><%= formatCurrency(totalOther) %></div><div class="metric-foot"><span>Dépenses ordinaires</span></div></article>
  <article class="metric-card"><div class="metric-heading"><span>Dépenses depuis l’épargne protégée</span></div><div class="metric-value"><%= formatCurrency(finance.protectedSavingsExpenses) %></div><div class="metric-foot"><span>Hors solde du compte courant</span></div></article>
  <article class="metric-card metric-featured"><div class="metric-heading"><span>Total général</span></div><div class="metric-value"><%= formatCurrency(totalGeneral) %></div><div class="metric-foot"><span><%= monthLabel %></span></div></article>
</section>

<%- include('partials/monthly-balance-summary', { finance }) %>

<section class="financial-summary-grid monthly-context-grid" aria-label="Autres indicateurs mensuels">
  <article class="finance-metric"><span>Loyers attendus / impayés</span><strong><%= formatCurrency(finance.rentExpected) %> / <%= formatCurrency(finance.rentOutstanding) %></strong></article>
  <article class="finance-metric"><span>Épargne cumulée</span><strong><%= formatCurrency(finance.savingsBalance) %></strong><small>Versements : <%= formatCurrency(finance.savingsDeposits) %></small></article>
</section>

<% if (categoryPresentation) { %>
<section class="category-presentation" aria-label="Synthèse des catégories">
  <div class="category-presentation-heading"><div><h2>Dépenses principales</h2><p>Répartition du mois, incluant les ravitaillements et l’épargne protégée.</p></div></div>
  <div class="category-card-grid">
    <% categoryPresentation.priority.forEach((group) => { %>
      <article class="category-summary-card">
        <div class="category-summary-main"><span class="category-summary-icon" aria-hidden="true"><%= group.icon %></span><div><h3><%= group.heading %></h3><strong><%= formatCurrency(group.total) %></strong><small><%= group.count %> opération<%= group.count > 1 ? 's' : '' %></small></div></div>
        <details class="category-details"><summary>Voir le détail</summary><% if (group.details.length) { %><ul><% group.details.forEach((row) => { %><li><span><%= row.title || row.item_name %><% if (row.funding_source === 'protected_savings') { %><small>Épargne protégée</small><% } %></span><strong><%= formatCurrency(row.amount || row.total_amount) %></strong></li><% }) %></ul><% } else { %><p>Aucune dépense ce mois-ci.</p><% } %></details>
        <div class="category-summary-actions">
          <% if (group.heading === 'Compte boutique') { %>
            <a class="text-link" href="/groceries?month=<%= encodeURIComponent(finance.monthKey) %>">Voir les ravitaillements</a>
          <% } else { %>
            <a class="text-link" href="/expenses?month=<%= encodeURIComponent(finance.monthKey) %>&amp;category_alias=<%= encodeURIComponent(group.heading) %>">Voir les dépenses</a>
            <% if (group.categoryIds && group.categoryIds.length) { %>
              <button class="table-action" type="button" data-modal-template="expense-create" data-expense-category-id="<%= group.categoryIds[0] %>" data-expense-month="<%= finance.monthKey %>">Ajouter</button>
            <% } else { %>
              <a class="table-action" href="/categories">Créer la catégorie</a>
            <% } %>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (categoryPresentation.extras.length) { %>
    <div class="category-presentation-heading category-extras-heading"><div><h2>Autres catégories</h2><p>Tri alphabétique français, noms conservés.</p></div></div>
    <div class="category-card-grid"><% categoryPresentation.extras.forEach((group) => { %><article class="category-summary-card category-summary-extra"><div class="category-summary-main"><span class="category-summary-icon" aria-hidden="true">📦</span><div><h3><%= group.heading %></h3><strong><%= formatCurrency(group.total) %></strong><small><%= group.count %> opération<%= group.count > 1 ? 's' : '' %></small></div></div><details class="category-details"><summary>Voir le détail</summary><% if (group.details.length) { %><ul><% group.details.forEach((row) => { %><li><span><%= row.title %><% if (row.funding_source === 'protected_savings') { %><small>Épargne protégée</small><% } %></span><strong><%= formatCurrency(row.amount) %></strong></li><% }) %></ul><% } else { %><p>Aucune dépense ce mois-ci.</p><% } %></details><div class="category-summary-actions"><a class="text-link" href="/expenses?month=<%= encodeURIComponent(finance.monthKey) %>&amp;category_alias=<%= encodeURIComponent(group.heading) %>">Voir les dépenses</a><% if (group.categoryIds && group.categoryIds.length) { %><button class="table-action" type="button" data-modal-template="expense-create" data-expense-category-id="<%= group.categoryIds[0] %>" data-expense-month="<%= finance.monthKey %>">Ajouter</button><% } %></div></article><% }) %></div>
  <% } %>
</section>
<% } %>

<section class="panel-card balance-correction-card">
  <div><h2>Correction du solde reporté</h2><p>Une correction est historisée et s’applique à partir de ce mois.</p></div>
  <form method="POST" action="/balances/adjustment">
    <input type="hidden" name="month_key" value="<%= finance.monthKey %>" />
    <label>Nouveau solde initial (FCFA)<input type="number" step="1" name="opening_balance" value="<%= finance.openingBalance %>" required /></label>
    <label>Motif de la correction<input type="text" name="reason" maxlength="500" required /></label>
    <button class="button button-subtle" type="submit">Enregistrer la correction</button>
  </form>
</section>

<section class="report-tables">
  <article class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Dépenses ordinaires</h2><p><%= monthlyOther.length %> opération<%= monthlyOther.length > 1 ? 's' : '' %>.</p></div></div>
    <% if (monthlyOther.length) { %>
      <div class="table-wrap"><table class="transactions-table">
        <thead><tr><th>DATE</th><th>INTITULÉ</th><th>CATÉGORIE</th><th class="amount-cell">MONTANT</th></tr></thead>
        <tbody><% monthlyOther.forEach((row) => { %><tr data-row-href="/expenses?month=<%= encodeURIComponent(finance.monthKey) %>&amp;search=<%= encodeURIComponent(row.title) %>" tabindex="0" aria-label="Voir la dépense <%= row.title %>"><td class="date-cell"><%= formatDate(row.expense_date) %></td><td><strong><%= row.title %></strong></td><td><%= row.category %></td><td class="amount-cell"><strong><%= formatCurrency(row.amount) %></strong></td></tr><% }) %></tbody>
      </table></div>
    <% } else { %><div class="empty-state"><strong>Aucune dépense ordinaire ce mois-ci</strong></div><% } %>
  </article>
  <article class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Dépenses financées par l’épargne protégée</h2><p><%= protectedSavingsExpenses.length %> opération<%= protectedSavingsExpenses.length > 1 ? 's' : '' %> · séparées du calcul du restant courant.</p></div></div>
    <% if (protectedSavingsExpenses.length) { %>
      <div class="table-wrap"><table class="transactions-table">
        <thead><tr><th>DATE</th><th>INTITULÉ</th><th>CATÉGORIE</th><th class="amount-cell">MONTANT</th></tr></thead>
        <tbody><% protectedSavingsExpenses.forEach((row) => { %><tr data-row-href="/history?type=expense&amp;month=<%= encodeURIComponent(finance.monthKey) %>&amp;search=<%= encodeURIComponent(row.title) %>" tabindex="0" aria-label="Voir la dépense protégée <%= row.title %>"><td class="date-cell"><%= formatDate(row.expense_date) %></td><td><strong><%= row.title %></strong></td><td><%= row.category %></td><td class="amount-cell"><strong><%= formatCurrency(row.amount) %></strong></td></tr><% }) %></tbody>
      </table></div>
    <% } else { %><div class="empty-state"><strong>Aucune dépense réglée par l’épargne protégée ce mois-ci</strong></div><% } %>
  </article>
  <article class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Compte boutique</h2><p><%= monthlyGroceries.length %> ravitaillement<%= monthlyGroceries.length > 1 ? 's' : '' %>.</p></div></div>
    <% if (monthlyGroceries.length) { %>
      <div class="table-wrap"><table class="transactions-table">
        <thead><tr><th>DATE</th><th>MARCHANDISE</th><th>QUANTITÉ</th><th class="amount-cell">MONTANT</th></tr></thead>
        <tbody><% monthlyGroceries.forEach((row) => { %><tr data-row-href="/history?type=grocery&amp;month=<%= encodeURIComponent(finance.monthKey) %>&amp;search=<%= encodeURIComponent(row.item_name) %>" tabindex="0" aria-label="Voir le ravitaillement <%= row.item_name %>"><td class="date-cell"><%= formatDate(row.purchase_date) %></td><td><strong><%= row.item_name %></strong></td><td><%= row.quantity_known ? row.quantity : '—' %> <%= row.unit || '' %></td><td class="amount-cell"><strong><%= formatCurrency(row.total_amount) %></strong></td></tr><% }) %></tbody>
      </table></div>
    <% } else { %><div class="empty-state"><strong>Aucun ravitaillement ce mois-ci</strong></div><% } %>
  </article>
</section>

<template id="monthly-export"><%- include('partials/export-confirmation', { year, month }) %></template>
<template id="expense-create"><%- include('partials/expense-form', { categories, expense: null, returnTo: '/expenses?month=' + encodeURIComponent(finance.monthKey) }) %></template>
<%- include('partials/page-end') %>
