<%- include('partials/page-start', {
  pageTitle: 'Historique',
  pageDescription: 'Consultez les opérations financières du foyer par période et par type.',
  activePage: 'history'
}) %>

<section class="page-toolbar">
  <div><h2>Historique des opérations</h2><p>Ajoutez une dépense directement depuis cet historique.</p></div>
  <button class="button button-primary" type="button" data-modal-template="expense-create" data-expense-month="<%= month %>"><span aria-hidden="true">＋</span> Ajouter une dépense</button>
</section>

<section class="panel-card page-filter-card">
  <form method="GET" action="/history" class="page-filter-form" data-live-search data-live-filter data-live-filter-root=".page-content">
    <label>Recherche
      <input type="search" name="search" value="<%= search || '' %>" placeholder="Intitulé, source, bénéficiaire" />
    </label>
    <label>Mois de rattachement
      <input type="month" name="month" value="<%= month %>" />
    </label>
    <label>Du
      <input type="date" name="start" value="<%= startDate %>" />
    </label>
    <label>Au
      <input type="date" name="end" value="<%= endDate %>" />
    </label>
    <label>Type d’opération
      <select name="type">
        <option value="">Tous les types</option>
        <option value="expense" <%= type === 'expense' ? 'selected' : '' %>>Dépenses</option>
        <option value="grocery" <%= type === 'grocery' ? 'selected' : '' %>>Compte boutique</option>
        <option value="income" <%= type === 'income' ? 'selected' : '' %>>Recettes</option>
        <option value="rent" <%= type === 'rent' ? 'selected' : '' %>>Paiements de loyer</option>
        <option value="savings" <%= type === 'savings' ? 'selected' : '' %>>Épargne</option>
      </select>
    </label>
    <button class="button button-subtle" type="submit">Rechercher</button>
  </form>
</section>

<section class="panel-card page-table-card">
  <div class="panel-header"><div><h2>Toutes les opérations</h2><p><%= totalCount %> opération<%= totalCount > 1 ? 's' : '' %> retrouvée<%= totalCount > 1 ? 's' : '' %> · page <%= page %> sur <%= pageCount %>.</p></div></div>
  <form id="expense-bulk-form" class="expense-bulk-toolbar" method="POST" action="/expenses/bulk">
    <input type="hidden" name="month_key" value="<%= month %>" />
    <input type="hidden" name="return_to" value="/history" />
    <label class="expense-bulk-target">Dupliquer vers le mois
      <input type="month" name="target_month" />
    </label>
    <button class="button button-subtle" type="button" data-modal-confirm="/expenses/bulk" data-modal-form-id="expense-bulk-form" data-modal-field-name="action" data-modal-field-value="duplicate" data-modal-include-selected="expense_ids" data-modal-title="Dupliquer les dépenses sélectionnées ?" data-modal-message="Les dépenses originales seront conservées. Les justificatifs ne sont pas copiés." data-modal-submit="Dupliquer">Dupliquer</button>
    <button class="button button-danger" type="button" data-modal-confirm="/expenses/bulk" data-modal-form-id="expense-bulk-form" data-modal-field-name="action" data-modal-field-value="delete" data-modal-include-selected="expense_ids" data-modal-title="Supprimer les dépenses sélectionnées ?" data-modal-message="Les dépenses choisies et leurs justificatifs seront supprimés définitivement." data-modal-submit="Supprimer" data-modal-danger="true">Supprimer</button>
    <span class="expense-selection-count" data-expense-selection-count aria-live="polite">0 sélectionnée</span>
  </form>
  <% if (operationList.length) { %>
    <div class="table-wrap">
      <table class="transactions-table">
        <thead><tr><th class="expense-select-cell"><input type="checkbox" aria-label="Tout sélectionner sur cette page" data-expense-select-all /></th><th>DATE</th><th>OPÉRATION</th><th>TYPE</th><th>CATÉGORIE</th><th class="amount-cell">MONTANT</th><th></th></tr></thead>
        <tbody>
          <% operationList.forEach((item) => { %>
            <% const rowHref = item.type === 'expense' && item.funding_source === 'protected_savings'
              ? item.source_id
                ? `/savings?open=savings-details-${encodeURIComponent(item.source_id)}`
                : `/savings?month=${encodeURIComponent(item.source_month)}`
              : item.type === 'expense'
              ? `/expenses?month=${encodeURIComponent(item.source_month)}&search=${encodeURIComponent(item.title)}&open=expense-details-${item.id}`
              : item.type === 'grocery'
                ? `/groceries?month=${encodeURIComponent(item.source_month)}&search=${encodeURIComponent(item.title)}&open=grocery-details-${item.id}`
                : item.type === 'income'
                  ? `/income?month=${encodeURIComponent(item.source_month)}&open=income-details-${item.id}`
                  : item.type === 'rent'
                    ? `/rents?month=${encodeURIComponent(item.source_month)}&open=rent-payment-details-${item.id}`
                    : `/savings?open=savings-details-${item.source_id}`; %>
            <tr data-row-href="<%= rowHref %>" tabindex="0" aria-label="Ouvrir <%= item.title %>">
              <td class="expense-select-cell"><% if (item.type === 'expense' && item.funding_source !== 'protected_savings') { %><input type="checkbox" name="expense_ids" value="<%= item.id %>" form="expense-bulk-form" aria-label="Sélectionner <%= item.title %>" data-expense-select /><% } %></td>
              <td class="date-cell"><%= item.date ? formatDate(item.date) : 'Sans date' %></td>
              <td><strong><%= item.title %></strong><% if (item.funding_source === 'protected_savings') { %><small class="page-note">Payée depuis l’épargne protégée</small><% } %></td>
              <td><%= item.funding_source === 'protected_savings' ? 'Dépense protégée' : ({ expense: 'Dépense', grocery: 'Ravitaillement', income: 'Recette', rent: 'Loyer encaissé', savings: 'Épargne' })[item.type] %></td>
              <td><span class="category-pill"><%= item.category %></span></td>
              <td class="amount-cell"><strong><%= formatCurrency(item.amount) %></strong></td>
              <td class="history-operation-cell"><div class="table-actions history-operation-actions">
                <% if (item.type === 'expense' && item.funding_source !== 'protected_savings') { %>
                  <button class="table-action icon-action" type="button" aria-label="Modifier <%= item.title %>" title="Modifier" data-modal-template="expense-edit-<%= item.id %>"><%- include('partials/action-icon', { icon: 'edit' }) %></button>
                <% } else if (item.type === 'grocery' && editableGroceriesById[item.source_id]) { %>
                  <button class="table-action icon-action" type="button" aria-label="Modifier <%= item.title %>" title="Modifier" data-modal-template="grocery-edit-<%= item.source_id %>"><%- include('partials/action-icon', { icon: 'edit' }) %></button>
                <% } %>
                <% if (['expense', 'grocery', 'income', 'rent'].includes(item.type)) { %>
                  <% const deleteUrl = item.type === 'rent' ? '/rents/payments/' + item.id + '/delete' : (item.type === 'grocery' ? '/groceries/' + item.id + '/delete' : (item.type === 'income' ? '/income/' + item.id + '/delete' : '/expenses/' + item.id + '/delete')); %>
                  <button class="table-action icon-action danger" type="button" aria-label="Supprimer <%= item.title %>" title="Supprimer" data-modal-confirm="<%= deleteUrl %>" data-modal-return="/history" data-modal-title="Supprimer cette opération ?" data-modal-message="Cette ligne sera retirée de l’historique et du bilan correspondant. La suppression sera inscrite dans le journal d’audit." data-modal-submit="Supprimer" data-modal-danger="true"><%- include('partials/action-icon', { icon: 'delete' }) %></button>
                <% } else { %><span class="page-note">Conservé</span><% } %>
              </div></td>
            </tr>
            <% if (item.type === 'expense' && editableExpensesById[item.id]) { %>
              <template id="expense-edit-<%= item.id %>"><%- include('partials/expense-form', { categories, expense: editableExpensesById[item.id], returnTo: '/history' }) %></template>
            <% } else if (item.type === 'grocery' && editableGroceriesById[item.source_id]) { %>
              <% const grocery = editableGroceriesById[item.source_id]; %>
              <template id="grocery-edit-<%= item.source_id %>"><%- include('partials/grocery-form', {
                grocery,
                selectedMonth: grocery.month_key || item.source_month,
                defaultPurchaseDate: grocery.purchase_date ? String(grocery.purchase_date).slice(0, 10) : '',
                returnTo: '/history',
              }) %></template>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state table-empty"><span class="empty-icon">⌁</span><strong>Aucune opération dans l’historique</strong><span>Essayez une autre recherche.</span></div>
  <% } %>
  <% if (pageCount > 1) { %>
    <nav class="pagination" aria-label="Pagination de l’historique">
      <% if (page > 1) { %><a class="button button-subtle" href="<%= pageUrl(page - 1) %>">Précédent</a><% } %>
      <span>Page <%= page %> / <%= pageCount %></span>
      <% if (page < pageCount) { %><a class="button button-subtle" href="<%= pageUrl(page + 1) %>">Suivant</a><% } %>
    </nav>
  <% } %>
</section>

<template id="expense-create"><%- include('partials/expense-form', { categories, expense: null, returnTo: '/history' }) %></template>
<%- include('partials/page-end') %>
