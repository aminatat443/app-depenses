<%- include('partials/page-start', {
  pageTitle: 'Historique',
  pageDescription: 'Consultez les opérations financières du foyer par période et par type.',
  activePage: 'history'
}) %>

<section class="panel-card page-filter-card">
  <form method="GET" action="/history" class="page-filter-form">
    <label>Recherche
      <input type="search" name="search" value="<%= search || '' %>" placeholder="Intitulé, source, bénéficiaire" />
    </label>
    <label>Mois de rattachement
      <input type="month" name="month" value="<%= month %>" />
    </label>
    <label>Du
      <input type="date" name="start" value="<%= startDate %>" />
    </label>
    <label>Au
      <input type="date" name="end" value="<%= endDate %>" />
    </label>
    <label>Type d’opération
      <select name="type">
        <option value="">Tous les types</option>
        <option value="expense" <%= type === 'expense' ? 'selected' : '' %>>Dépenses</option>
        <option value="grocery" <%= type === 'grocery' ? 'selected' : '' %>>Compte boutique</option>
        <option value="income" <%= type === 'income' ? 'selected' : '' %>>Recettes</option>
        <option value="rent" <%= type === 'rent' ? 'selected' : '' %>>Paiements de loyer</option>
        <option value="savings" <%= type === 'savings' ? 'selected' : '' %>>Épargne</option>
      </select>
    </label>
    <button class="button button-subtle" type="submit">Rechercher</button>
  </form>
</section>

<section class="panel-card page-table-card">
  <div class="panel-header"><div><h2>Toutes les opérations</h2><p><%= totalCount %> opération<%= totalCount > 1 ? 's' : '' %> retrouvée<%= totalCount > 1 ? 's' : '' %> · page <%= page %> sur <%= pageCount %>.</p></div></div>
  <% if (operationList.length) { %>
    <div class="table-wrap">
      <table class="transactions-table">
        <thead><tr><th>DATE</th><th>OPÉRATION</th><th>TYPE</th><th>CATÉGORIE</th><th class="amount-cell">MONTANT</th><th></th></tr></thead>
        <tbody>
          <% operationList.forEach((item) => { %>
            <tr>
              <td class="date-cell"><%= formatDate(item.date) %></td>
              <td><strong><%= item.title %></strong></td>
              <td><%= ({ expense: 'Dépense', grocery: 'Ravitaillement', income: 'Recette', rent: 'Loyer encaissé', savings: 'Épargne' })[item.type] %></td>
              <td><span class="category-pill"><%= item.category %></span></td>
              <td class="amount-cell"><strong><%= formatCurrency(item.amount) %></strong></td>
              <td>
                <% if (['expense', 'grocery', 'income'].includes(item.type)) { %>
                  <% const deleteUrl = item.type === 'grocery' ? '/groceries/' + item.id + '/delete' : (item.type === 'income' ? '/income/' + item.id + '/delete' : '/expenses/' + item.id + '/delete'); %>
                  <button class="table-action danger" type="button" data-modal-confirm="<%= deleteUrl %>" data-modal-return="/history" data-modal-title="Supprimer cette opération ?" data-modal-message="Cette ligne sera retirée de l’historique et du bilan correspondant." data-modal-submit="Supprimer" data-modal-danger="true">Supprimer</button>
                <% } else { %><span class="page-note">Conservé</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state table-empty"><span class="empty-icon">⌁</span><strong>Aucune opération dans l’historique</strong><span>Essayez une autre recherche.</span></div>
  <% } %>
  <% if (pageCount > 1) { %>
    <nav class="pagination" aria-label="Pagination de l’historique">
      <% if (page > 1) { %><a class="button button-subtle" href="<%= pageUrl(page - 1) %>">Précédent</a><% } %>
      <span>Page <%= page %> / <%= pageCount %></span>
      <% if (page < pageCount) { %><a class="button button-subtle" href="<%= pageUrl(page + 1) %>">Suivant</a><% } %>
    </nav>
  <% } %>
</section>

<%- include('partials/page-end') %>
