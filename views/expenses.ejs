<%- include('partials/page-start', {
  pageTitle: 'Dépenses du mois',
  pageDescription: 'Consultez et classez les dépenses ordinaires de la maison.',
  activePage: 'expenses'
}) %>

<section class="page-toolbar">
  <div><h2>Opérations · <%= monthKey %></h2><p><%= expenseList.length %> dépense<%= expenseList.length > 1 ? 's' : '' %> sur la période</p></div>
  <button class="button button-primary" type="button" data-modal-template="expense-create"><span aria-hidden="true">＋</span> Ajouter une dépense</button>
</section>

<section class="panel-card page-filter-card">
  <form method="GET" action="/expenses" class="page-filter-form">
    <label>Mois
      <input type="month" name="month" value="<%= monthKey %>" />
    </label>
    <label>Recherche
      <input type="search" name="search" value="<%= search || '' %>" placeholder="Intitulé, description, référence" />
    </label>
    <button class="button button-subtle" type="submit">Filtrer les dépenses</button>
  </form>
</section>

<section class="panel-card page-table-card">
  <div class="panel-header">
    <div><h2>Historique du mois</h2><p>Dépenses ordinaires classées par date.</p></div>
    <a class="text-link" href="/history">Tout l’historique <span aria-hidden="true">→</span></a>
  </div>
  <% if (expenseList.length) { %>
    <div class="table-wrap">
      <table class="transactions-table">
        <thead><tr><th>DATE</th><th>INTITULÉ</th><th>CATÉGORIE</th><th>RÉFÉRENCE</th><th>DESCRIPTION</th><th class="amount-cell">MONTANT</th><th></th></tr></thead>
        <tbody>
          <% expenseList.forEach((row) => { %>
            <tr>
              <td class="date-cell"><%= formatDate(row.expense_date) %></td>
              <td><strong><%= row.title %></strong></td>
              <td><span class="category-pill"><%= row.category_name %></span></td>
              <td><%= row.reference || '—' %></td>
              <td><%= row.description || '—' %></td>
              <td class="amount-cell"><strong><%= formatCurrency(row.amount) %></strong></td>
              <td><button class="table-action danger" type="button" data-modal-confirm="/expenses/<%= row.id %>/delete" data-modal-title="Supprimer cette dépense ?" data-modal-message="Cette opération sera supprimée de l’historique." data-modal-submit="Supprimer" data-modal-danger="true">Supprimer</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state table-empty"><span class="empty-icon">⌁</span><strong>Aucune dépense pour ce mois</strong><span>Ajoutez une dépense ou ajustez les filtres.</span></div>
  <% } %>
</section>

<template id="expense-create"><%- include('partials/expense-form', { categories }) %></template>
<%- include('partials/page-end') %>
