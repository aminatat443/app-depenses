<%- include('partials/page-start', {
  pageTitle: 'Dépenses du mois',
  pageDescription: 'Consultez et classez les dépenses ordinaires de la maison.',
  activePage: 'expenses'
}) %>

<section class="page-toolbar">
  <div><h2>Opérations · <%= monthKey %></h2><p><%= totalCount %> dépense<%= totalCount === 1 ? '' : 's' %> sur la période</p></div>
  <button class="button button-primary" type="button" data-modal-template="expense-create" data-expense-month="<%= monthKey %>"><span aria-hidden="true">＋</span> Ajouter une dépense</button>
</section>

<%- include('partials/monthly-balance-summary', { finance }) %>

<section class="panel-card page-filter-card">
  <form method="GET" action="/expenses" class="page-filter-form expense-month-filter" data-live-filter data-live-filter-root=".page-content" data-expense-month-filter>
    <label>Mois<input type="month" name="month" value="<%= monthKey %>" /></label>
    <div class="expense-month-shortcuts" aria-label="Raccourcis de mois">
      <button class="table-action" type="button" data-expense-month-offset="-1" aria-label="Mois précédent">‹</button>
      <button class="table-action" type="button" data-expense-current-month>Ce mois-ci</button>
      <button class="table-action" type="button" data-expense-month-offset="1" aria-label="Mois suivant">›</button>
    </div>
    <label class="expense-category-filter-search">Rechercher une catégorie
      <input type="search" data-category-option-search placeholder="Nom de catégorie…" autocomplete="off" />
      <small class="sr-only" data-category-search-status role="status" aria-live="polite"></small>
    </label>
    <label>Catégorie
      <select name="category">
        <option value="">Toutes les catégories</option>
        <% categories.forEach((category) => { %><option value="<%= category.id %>" <%= selectedCategory === String(category.id) ? 'selected' : '' %>><%= category.name %></option><% }) %>
      </select>
    </label>
    <input type="hidden" name="search" value="<%= search || '' %>" />
    <input type="hidden" name="category_alias" value="<%= selectedCategoryAlias || '' %>" />
    <button class="button button-subtle" type="submit">Filtrer</button>
  </form>
</section>

<% if (categoryPresentation) { %>
<section class="category-presentation" aria-label="Synthèse des catégories">
  <div class="category-presentation-heading">
    <div><h2>Dépenses principales</h2><p>Les cartes reflètent les catégories actuellement disponibles.</p></div>
    <div class="category-presentation-actions">
      <button class="button button-primary" type="button" data-modal-template="category-create"><span aria-hidden="true">＋</span> Créer une catégorie</button>
      <a class="button button-subtle" href="/categories?return_to=%2Fexpenses%3Fmonth%3D<%= encodeURIComponent(monthKey) %>">Modifier ou supprimer</a>
    </div>
  </div>
  <div class="category-card-grid">
    <% categoryPresentation.priority.forEach((group) => { %>
      <article class="category-summary-card">
        <div class="category-summary-main">
          <span class="category-summary-icon" aria-hidden="true"><%= group.icon %></span>
          <div><h3><%= group.heading %></h3><strong><%= formatCurrency(group.total) %></strong><small><%= group.count %> opération<%= group.count > 1 ? 's' : '' %></small></div>
        </div>
        <details class="category-details">
          <summary>Voir le détail</summary>
          <% if (group.details.length) { %>
            <ul><% group.details.forEach((row) => { %><li><span><%= row.title || row.item_name %><% if (row.funding_source === 'protected_savings') { %><small>Épargne protégée</small><% } %></span><strong><%= formatCurrency(row.amount || row.total_amount) %></strong></li><% }) %></ul>
          <% } else { %><p>Aucune dépense ce mois-ci.</p><% } %>
        </details>
        <div class="category-summary-actions">
          <% if (group.heading === 'Compte boutique') { %>
            <a class="text-link" href="/groceries?month=<%= encodeURIComponent(monthKey) %>">Voir les ravitaillements</a>
          <% } else { %>
            <a class="text-link" href="/expenses?month=<%= encodeURIComponent(monthKey) %>&amp;category=<%= group.categoryIds[0] %>">Voir les dépenses</a>
            <% if (group.categoryIds && group.categoryIds.length) { %>
              <button class="table-action" type="button" data-modal-template="expense-create" data-expense-category-id="<%= group.categoryIds[0] %>" data-expense-month="<%= monthKey %>">Ajouter</button>
            <% } else { %>
              <a class="table-action" href="/categories">Créer la catégorie</a>
            <% } %>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (categoryPresentation.extras.length) { %>
    <div class="category-presentation-heading category-extras-heading"><div><h2>Autres catégories</h2><p>Noms conservés exactement comme enregistrés.</p></div></div>
    <div class="category-card-grid">
      <% categoryPresentation.extras.forEach((group) => { %>
        <article class="category-summary-card category-summary-extra">
          <div class="category-summary-main"><span class="category-summary-icon" aria-hidden="true"><%= group.icon %></span><div><h3><%= group.heading %></h3><strong><%= formatCurrency(group.total) %></strong><small><%= group.count %> opération<%= group.count > 1 ? 's' : '' %></small></div></div>
          <details class="category-details"><summary>Voir le détail</summary><% if (group.details.length) { %><ul><% group.details.forEach((row) => { %><li><span><%= row.title %><% if (row.funding_source === 'protected_savings') { %><small>Épargne protégée</small><% } %></span><strong><%= formatCurrency(row.amount) %></strong></li><% }) %></ul><% } else { %><p>Aucune dépense ce mois-ci.</p><% } %></details>
          <div class="category-summary-actions"><a class="text-link" href="/expenses?month=<%= encodeURIComponent(monthKey) %>&amp;category=<%= group.categoryIds[0] %>">Voir les dépenses</a><% if (group.categoryIds && group.categoryIds.length) { %><button class="table-action" type="button" data-modal-template="expense-create" data-expense-category-id="<%= group.categoryIds[0] %>" data-expense-month="<%= monthKey %>">Ajouter</button><% } %></div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<% } %>

<section class="panel-card page-table-card monthly-expense-history">
  <div class="panel-header">
    <div><h2>Liste des dépenses</h2><p>Dépenses ordinaires classées par date.</p></div>
    <div class="expense-table-header-actions">
      <button class="button button-primary" type="button" data-modal-template="expense-create" data-expense-month="<%= monthKey %>"><span aria-hidden="true">＋</span> Ajouter une dépense</button>
      <a class="button button-subtle" href="/export/month/<%= monthKey.slice(0, 4) %>/<%= Number(monthKey.slice(5, 7)) %>">Exporter en Excel</a>
      <%- include('partials/excel-native-actions', { exportUrl: `/export/month/${monthKey.slice(0, 4)}/${Number(monthKey.slice(5, 7))}`, caption: `Classeur Excel ${monthKey} · Dépenses maison` }) %>
      <a class="text-link" href="/history">Tout l’historique <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <form method="GET" action="/expenses" class="expense-live-search" data-live-search data-expense-list-search>
    <input type="hidden" name="month" value="<%= monthKey %>" />
    <input type="hidden" name="category" value="<%= selectedCategory || '' %>" />
    <input type="hidden" name="category_alias" value="<%= selectedCategoryAlias || '' %>" />
    <label>Rechercher dans les dépenses du mois
      <input type="search" name="search" value="<%= search || '' %>" placeholder="Désignation, catégorie, bénéficiaire…" autocomplete="off" />
    </label>
    <small>Recherche limitée au mois sélectionné · résultats mis à jour sans recharger la page.</small>
  </form>
  <form id="expense-bulk-form" class="expense-bulk-toolbar" method="POST" action="/expenses/bulk">
    <input type="hidden" name="month_key" value="<%= monthKey %>" />
    <input type="hidden" name="return_to" value="/expenses?month=<%= monthKey %>" />
    <label class="expense-bulk-target">Dupliquer vers le mois
      <input type="month" name="target_month" />
    </label>
    <button class="button button-subtle" type="button" data-modal-confirm="/expenses/bulk" data-modal-form-id="expense-bulk-form" data-modal-field-name="action" data-modal-field-value="duplicate" data-modal-include-selected="expense_ids" data-modal-title="Dupliquer les dépenses sélectionnées ?" data-modal-message="Les dépenses originales seront conservées. Les justificatifs ne sont pas copiés." data-modal-submit="Dupliquer">Dupliquer</button>
    <button class="button button-danger" type="button" data-modal-confirm="/expenses/bulk" data-modal-form-id="expense-bulk-form" data-modal-field-name="action" data-modal-field-value="delete" data-modal-include-selected="expense_ids" data-modal-title="Supprimer les dépenses sélectionnées ?" data-modal-message="Les dépenses choisies et leurs justificatifs seront supprimés définitivement." data-modal-submit="Supprimer" data-modal-danger="true">Supprimer</button>
    <span class="expense-selection-count" data-expense-selection-count aria-live="polite">0 sélectionnée</span>
  </form>
  <div class="monthly-shop-total" aria-label="Compte boutique du mois <%= monthKey %>">
    <span>Compte boutique · <%= monthKey %></span>
    <strong><%= formatCurrency(finance.boutiqueExpenses) %></strong>
  </div>
  <% if (expenseList.length) { %>
    <div class="table-wrap">
      <table class="transactions-table">
        <thead><tr><th class="expense-select-cell"><input type="checkbox" aria-label="Tout sélectionner sur cette page" data-expense-select-all /></th><th>DATE</th><th>DÉSIGNATION</th><th>CATÉGORIE</th><th>BÉNÉFICIAIRE</th><th>RÉFÉRENCE</th><th class="amount-cell">MONTANT</th><th>ACTIONS</th></tr></thead>
        <tbody>
          <% expenseList.forEach((row) => { %>
            <tr data-modal-template="expense-details-<%= row.id %>" tabindex="0" aria-label="Afficher le détail de <%= row.title %>">
              <td class="expense-select-cell"><input type="checkbox" name="expense_ids" value="<%= row.id %>" form="expense-bulk-form" aria-label="Sélectionner <%= row.title %>" data-expense-select /></td>
              <td class="date-cell"><%= row.expense_date ? formatDate(row.expense_date) : 'Sans date' %></td>
              <td><strong class="expense-row-title" title="<%= row.title %>"><%= row.title %></strong><% if (row.funding_source === 'protected_savings') { %><small class="page-note">Payée depuis l’épargne protégée</small><% } %></td>
              <td><span class="category-pill"><%= row.category_name %></span></td>
              <td><%= row.beneficiary || '—' %></td>
              <td><%= row.reference || '—' %></td>
              <td class="amount-cell"><strong><%= formatCurrency(row.amount) %></strong></td>
              <td class="table-actions">
                <button class="table-action icon-action" type="button" aria-label="Afficher le détail de <%= row.title %>" title="Détail" data-modal-template="expense-details-<%= row.id %>"><%- include('partials/action-icon', { icon: 'view' }) %></button>
                <% if (row.funding_source !== 'protected_savings') { %><button class="table-action icon-action" type="button" aria-label="Modifier <%= row.title %>" title="Modifier" data-modal-template="expense-edit-<%= row.id %>"><%- include('partials/action-icon', { icon: 'edit' }) %></button>
                <button class="table-action icon-action danger" type="button" aria-label="Supprimer <%= row.title %>" title="Supprimer" data-modal-confirm="/expenses/<%= row.id %>/delete" data-modal-title="Supprimer cette dépense ?" data-modal-message="Cette opération et ses justificatifs seront supprimés de l’historique." data-modal-submit="Supprimer" data-modal-danger="true"><%- include('partials/action-icon', { icon: 'delete' }) %></button><% } else { %><span class="page-note">Mouvement protégé</span><% } %>
              </td>
            </tr>
            <template id="expense-edit-<%= row.id %>"><%- include('partials/expense-form', { categories, expense: row, returnTo: '/expenses' }) %></template>
            <template id="expense-details-<%= row.id %>">
              <div class="modal-heading"><span class="eyebrow">DÉTAIL DE L’OPÉRATION</span><h2><%= row.title %></h2><p><%= row.category_name %> · <%= row.expense_date ? formatDate(row.expense_date) : 'Sans date' %></p></div>
              <dl class="detail-list">
                <div><dt>Montant</dt><dd><%= formatCurrency(row.amount) %></dd></div>
                <div><dt>Mois rattaché</dt><dd><%= row.month_key || (row.expense_date ? String(row.expense_date).slice(0, 7) : '—') %></dd></div>
                <div><dt>Bénéficiaire</dt><dd><%= row.beneficiary || '—' %></dd></div>
                <div><dt>Payé par</dt><dd><%= row.paid_by || '—' %></dd></div>
                <div><dt>Mode de paiement</dt><dd><%= row.payment_method || '—' %></dd></div>
                <div><dt>Source de financement</dt><dd><%= row.funding_source === 'protected_savings' ? 'Épargne protégée' : 'Compte courant' %></dd></div>
                <div><dt>Référence</dt><dd><%= row.reference || '—' %></dd></div>
                <div><dt>Commentaire</dt><dd><%= row.description || '—' %></dd></div>
                <% if (Number(row.attachment_count) > 0) { %><div><dt>Justificatif</dt><dd><a class="text-link" href="/expenses/<%= row.id %>/receipt" target="_blank" rel="noopener">Ouvrir le fichier</a></dd></div><% } %>
              </dl>
              <div class="modal-actions">
                <% if (row.funding_source !== 'protected_savings') { %>
                  <button class="table-action" type="button" aria-label="Modifier <%= row.title %>" data-modal-template="expense-edit-<%= row.id %>">Modifier</button>
                  <button class="table-action danger" type="button" aria-label="Supprimer <%= row.title %>" data-modal-confirm="/expenses/<%= row.id %>/delete" data-modal-return="/expenses?month=<%= monthKey %>" data-modal-title="Supprimer cette dépense ?" data-modal-message="Cette opération et ses justificatifs seront supprimés de l’historique." data-modal-submit="Supprimer" data-modal-danger="true">Supprimer</button>
                <% } %>
              </div>
            </template>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (totalCount > pageSize) { %>
      <nav class="pagination" aria-label="Pagination">
        <% if (page > 1) { %><a class="button button-subtle" href="/expenses?month=<%= monthKey %>&category=<%= selectedCategory %>&search=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>">Précédent</a><% } %>
        <span>Page <%= page %> / <%= Math.ceil(totalCount / pageSize) %></span>
        <% if (page * pageSize < totalCount) { %><a class="button button-subtle" href="/expenses?month=<%= monthKey %>&category=<%= selectedCategory %>&search=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>">Suivant</a><% } %>
      </nav>
    <% } %>
  <% } else { %>
    <div class="empty-state table-empty"><span class="empty-icon">⌁</span><strong>Aucune dépense pour ce mois</strong><span>Ajoutez une dépense ou ajustez les filtres.</span></div>
  <% } %>
</section>

<template id="expense-create"><%- include('partials/expense-form', { categories, expense: null, returnTo: '/expenses' }) %></template>
<template id="category-create"><%- include('partials/category-form', { returnTo: `/expenses?month=${monthKey}` }) %></template>
<%- include('partials/page-end') %>
