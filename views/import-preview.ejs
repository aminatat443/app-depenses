<%- include('partials/page-start', {
  pageTitle: 'Prévisualisation d’import',
  pageDescription: 'Vérifiez les lignes détectées avant de les ajouter à vos données.',
  activePage: 'import'
}) %>

<%
  const tenantRows = typeof tenants === 'undefined' ? [] : tenants;
  const rentRows = typeof rentPayments === 'undefined' ? [] : rentPayments;
  const incomeRows = typeof incomes === 'undefined' ? [] : incomes;
  const savingsRows = typeof savings === 'undefined' ? [] : savings;
  const totalRows = typeof totals === 'undefined' ? [] : totals;
  const classifiedLineRows = typeof classifiedRows === 'undefined' ? [] : classifiedRows;
  const periodWarningRows = typeof periodWarnings === 'undefined' ? [] : periodWarnings;
  const validRecords = records.filter((row) => row.valid);
  const ordinaryCount = validRecords.filter((row) => row.type === 'expense').length;
  const groceryCount = validRecords.filter((row) => row.type === 'grocery').length;
  const coveredMonths = monthly.filter((row) => row.ordinaryCount + row.groceryCount > 0).length;
  const incompleteRows = records.filter((row) => !row.valid);
  const unknownCategories = [...new Set(records
    .filter((row) => row.type === 'expense' && !row.categoryRecognized)
    .map((row) => row.categoryRaw || '(catégorie absente)'))];
  const recognizedCategories = [...new Set(records
    .filter((row) => row.type === 'expense' && row.categoryRecognized)
    .map((row) => row.categoryName))];
  const unresolvedSummary = summaryLines.some((row) => row.unresolved || row.mismatch);
  const importableCount = records.filter((row) => row.valid && !row.duplicateSource).length
    + tenantRows.filter((row) => row.valid).length
    + rentRows.filter((row) => row.valid && !row.duplicateSource).length
    + incomeRows.filter((row) => row.valid && !row.duplicateSource).length
    + savingsRows.filter((row) => row.valid && !row.duplicateSource).length;
  const rawRows = ignoredRows.filter((row) => row.values);
  const fileDuplicateCount = records.filter((row) => row.duplicateSource === 'fichier').length;
  const sourceLineCount = classifiedLineRows.filter((row) => row.classification !== 'blank').length;
  const invalidRentCount = rentRows.filter((row) => !row.valid).length;
  const invalidIncomeCount = incomeRows.filter((row) => !row.valid).length;
  const invalidSavingsCount = savingsRows.filter((row) => !row.valid).length;
  const mismatchedExpenseTotals = totalRows.filter((row) => row.kind === 'expense-total' && row.mismatch);
  const categoryCounts = [
    ['Locataires', tenantRows.length],
    ['Paiements de loyer', rentRows.length],
    ['Dépenses', records.length],
    ['Recettes', incomeRows.length],
    ['Soldes d’épargne', savingsRows.length],
    ['Totaux / soldes', totalRows.length],
    ['Lignes non reconnues', rawRows.length],
  ];
%>

<section class="page-toolbar">
  <div>
    <h2><%= previewBatch.file_name %></h2>
    <p><%= sourceLineCount %> ligne(s) non vides analysées ; <%= records.length %> dépenses/marchandises, <%= tenantRows.length %> locataires uniques et <%= rentRows.length %> statuts de loyer détectés.</p>
    <p class="page-note">Feuilles analysées : <%= sheetNames.join(', ') %></p>
  </div>
  <% if (initialImportComplete) { %>
    <button class="button button-primary" type="button" data-modal-confirm="/import/confirm/<%= previewBatch.id %>" data-modal-title="Confirmer l’import ?" data-modal-message="Les lignes valides non dupliquées seront ajoutées. Aucune donnée existante ne sera supprimée." data-modal-submit="Valider l’import" <%= importableCount === 0 || unresolvedSummary || fileDuplicateCount > 0 || rawRows.length > 0 || invalidRentCount > 0 || invalidIncomeCount > 0 || invalidSavingsCount > 0 || mismatchedExpenseTotals.length > 0 ? 'disabled' : '' %>>Valider l’import</button>
  <% } else { %>
    <button class="button button-primary" type="button" data-modal-confirm="/import/confirm/<%= previewBatch.id %>" data-modal-field-name="reinitialize" data-modal-field-value="1" data-modal-title="Sauvegarder et remplacer l’historique ?" data-modal-message="Une sauvegarde complète sera créée et vérifiée. Ensuite, les anciennes dépenses, marchandises et importations seront supprimées, puis ce fichier sera importé en une transaction. Les catégories et paramètres seront conservés." data-modal-submit="Sauvegarder, nettoyer et importer" <%= !reinitializeAvailable || unresolvedSummary || fileDuplicateCount > 0 || rawRows.length > 0 || invalidRentCount > 0 || invalidIncomeCount > 0 || invalidSavingsCount > 0 || mismatchedExpenseTotals.length > 0 ? 'disabled' : '' %>>Sauvegarder, nettoyer et importer</button>
  <% } %>
</section>

<section class="summary-grid report-summary">
  <% categoryCounts.forEach(([label, count]) => { %>
    <article class="metric-card"><div class="metric-heading"><span><%= label %></span></div><div class="metric-value"><%= count %></div><div class="metric-foot"><span>Données détectées</span></div></article>
  <% }) %>
</section>

<% if (periodWarningRows.length) { %>
  <div class="page-alert"><strong>Périodes à vérifier :</strong> le titre de la section ne correspond pas au nom de la feuille. Le mois de rattachement affiché vient du nom de la feuille ; aucune date ni période n’a été inventée.
    <ul><% periodWarningRows.forEach((warning) => { %><li><%= warning.sheetName %>, ligne <%= warning.rowNumber %> : « <%= warning.content %> » (feuille <%= warning.sheetMonth %>, titre <%= warning.declaredMonth %>).</li><% }) %></ul>
  </div>
<% } %>

<section class="summary-grid report-summary">
  <article class="metric-card"><div class="metric-heading"><span>Dépenses ordinaires valides</span></div><div class="metric-value"><%= ordinaryCount %></div><div class="metric-foot"><span>2026 et années suivantes</span></div></article>
  <article class="metric-card"><div class="metric-heading"><span>Marchandises boutique</span></div><div class="metric-value"><%= groceryCount %></div><div class="metric-foot"><span>Lignes détaillées</span></div></article>
  <article class="metric-card"><div class="metric-heading"><span>Mois concernés</span></div><div class="metric-value"><%= coveredMonths %></div><div class="metric-foot"><span>Mois avec opérations détectées</span></div></article>
  <article class="metric-card"><div class="metric-heading"><span>Lignes à vérifier</span></div><div class="metric-value"><%= incompleteRows.length + records.filter((row) => row.issues.length && row.valid).length %></div><div class="metric-foot"><span>Incomplètes ou signalées</span></div></article>
</section>

<% if (tenantRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Locataires détectés</h2><p><%= tenantRows.length %> locataire(s) uniques dédupliqués entre les feuilles.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>ÉTAGE</th><th>LOCATAIRE</th><th>LOGEMENT</th><th>PERSONNES</th><th class="amount-cell">LOYER MENSUEL</th></tr></thead><tbody>
      <% tenantRows.forEach((tenant) => { %><tr><td><%= tenant.floor || '—' %></td><td><strong><%= tenant.fullName %></strong></td><td><%= tenant.housingType || '—' %></td><td><%= tenant.peopleCount %></td><td class="amount-cell"><%= formatCurrency(tenant.monthlyRent) %></td></tr><% }) %>
    </tbody></table></div>
  </section>
<% } %>

<% if (rentRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Statuts de loyers détectés</h2><p>Le classeur ne donne pas les dates de paiement ; elles restent vides.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>MOIS</th><th>LOCATAIRE</th><th>STATUT SOURCE</th><th class="amount-cell">ATTENDU</th><th class="amount-cell">ENCAISSÉ</th></tr></thead><tbody>
      <% rentRows.forEach((payment) => { %><tr><td><%= payment.monthKey || '—' %></td><td><%= payment.tenantName %><small><%= payment.sheetName %>, ligne <%= payment.rowNumber %></small></td><td><%= payment.statusText || 'Non reconnu' %></td><td class="amount-cell"><%= formatCurrency(payment.expectedAmount) %></td><td class="amount-cell"><%= payment.paidAmount === null ? '—' : formatCurrency(payment.paidAmount) %></td></tr><% }) %>
    </tbody></table></div>
  </section>
<% } %>

<% if (incomeRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Recettes détectées</h2><p>Les loyers restent séparés de ces recettes pour éviter le double comptage.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>MOIS</th><th>DÉSIGNATION</th><th>SOURCE</th><th class="amount-cell">MONTANT</th></tr></thead><tbody>
      <% incomeRows.forEach((income) => { %><tr><td><%= income.monthKey || '—' %></td><td><%= income.title %><small><%= income.sheetName %>, ligne <%= income.rowNumber %></small></td><td><%= income.source %></td><td class="amount-cell"><%= formatCurrency(income.amount) %></td></tr><% }) %>
    </tbody></table></div>
  </section>
<% } %>

<% if (savingsRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Soldes d’épargne observés</h2><p>Ils sont enregistrés comme instantanés mensuels et ne sont pas additionnés aux versements.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>FEUILLE</th><th>LIBELLÉ</th><th class="amount-cell">MONTANT SOURCE</th><th>TRAITEMENT</th></tr></thead><tbody>
      <% savingsRows.forEach((saving) => { %><tr><td><%= saving.sheetName %></td><td><%= saving.name %><small>Ligne <%= saving.rowNumber %></small></td><td class="amount-cell"><%= formatCurrency(saving.amount) %></td><td><%= saving.reason %></td></tr><% }) %>
    </tbody></table></div>
  </section>
<% } %>

<% if (totalRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Totaux et soldes détectés</h2><p>Ils servent au contrôle, sans être enregistrés comme opérations.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>FEUILLE</th><th>LIGNE</th><th>LIBELLÉ</th><th>TYPE</th><th class="amount-cell">MONTANT SOURCE</th><th>FORMULE</th></tr></thead><tbody>
      <% totalRows.forEach((total) => { %><tr><td><%= total.sheetName %></td><td><%= total.rowNumber %></td><td><%= total.label %></td><td><%= total.kind %><% if (total.kind === 'expense-total') { %><small><%= total.mismatch ? 'Écart à vérifier' : 'Concorde avec les détails' %></small><% } %></td><td class="amount-cell"><%= total.amount === null ? '—' : formatCurrency(total.amount) %></td><td><%= total.formulas.length ? total.formulas.map((formula) => formula.formula).join(' · ') : 'Valeur saisie' %></td></tr><% }) %>
    </tbody></table></div>
  </section>
<% } %>

<% if (unknownCategories.length) { %>
  <div class="page-alert"><strong>Catégories classées dans Autres :</strong> <%= unknownCategories.join(', ') %>. Les intitulés d’origine sont conservés.</div>
<% } %>
<% if (duplicates.length) { %>
  <div class="page-alert"><strong>Doublons potentiels :</strong> <%= duplicates.length %> ligne(s) identique(s) à une autre ligne du fichier ou déjà présente(s) en base. Les doublons déjà en base ne seront pas réajoutés ; les doublons présents dans le fichier bloquent la validation afin d’éviter d’écarter un achat légitime.</div>
<% } %>
<% if (incompleteRows.length) { %>
  <div class="page-alert"><strong>Lignes incomplètes :</strong> <%= incompleteRows.length %>. Elles restent visibles ci-dessous et ne seront pas importées tant que leur date, intitulé ou montant manque.</div>
<% } %>
<% if (unresolvedSummary) { %>
  <div class="page-alert"><strong>Vérification boutique requise :</strong> un total mensuel n’a pas de détail marchandises correspondant, ou son montant ne correspond pas à la somme des marchandises. L’import est bloqué pour éviter une perte ou une double comptabilisation.</div>
<% } %>
<% if (mismatchedExpenseTotals.length) { %>
  <div class="page-alert"><strong>Écart entre les opérations et les totaux source :</strong> <%= mismatchedExpenseTotals.length %> total(aux) ne correspond(ent) pas à la somme détaillée. L’import reste bloqué jusqu’à vérification.</div>
<% } %>
<% if (!validRecords.length) { %>
  <div class="page-alert"><strong>Aucune dépense valide datée de 2026 ou après n’a été trouvée.</strong> Le fichier peut être consulté, mais il ne peut pas déclencher le nettoyage initial.</div>
<% } %>

<section class="panel-card page-table-card">
  <div class="panel-header"><div><h2>Totaux par mois</h2><p>Le total général correspond aux dépenses boutique et aux autres dépenses.</p></div></div>
  <div class="table-wrap"><table class="transactions-table">
    <thead><tr><th>MOIS</th><th>DÉPENSES ORDINAIRES</th><th>MARCHANDISES</th><th class="amount-cell">BOUTIQUE</th><th class="amount-cell">AUTRES DÉPENSES</th><th class="amount-cell">TOTAL GÉNÉRAL</th></tr></thead>
    <tbody><% monthly.forEach((row) => { %><tr>
      <td><strong><%= row.label %></strong></td><td><%= row.ordinaryCount %></td><td><%= row.groceryCount %></td>
      <td class="amount-cell"><%= formatCurrency(row.totalBoutique) %></td><td class="amount-cell"><%= formatCurrency(row.totalOther) %></td><td class="amount-cell"><strong><%= formatCurrency(row.totalGeneral) %></strong></td>
    </tr><% }) %></tbody>
  </table></div>
</section>

<section class="report-tables">
  <article class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Catégories reconnues</h2><p><%= recognizedCategories.length %> catégorie(s) reconnue(s).</p></div></div>
    <p class="page-note"><%= recognizedCategories.length ? recognizedCategories.join(', ') : 'Aucune catégorie reconnue.' %></p>
  </article>
  <article class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Totaux boutique source</h2><p>Les lignes de total ne sont jamais ajoutées comme dépense supplémentaire.</p></div></div>
    <% if (summaryLines.length) { %>
      <div class="table-wrap"><table class="transactions-table"><thead><tr><th>FEUILLE</th><th>DATE</th><th class="amount-cell">TOTAL SOURCE</th><th class="amount-cell">MARCHANDISES</th><th>ÉTAT</th></tr></thead><tbody>
        <% summaryLines.forEach((row) => { %><tr><td><%= row.sheetName %></td><td><%= row.date || '—' %></td><td class="amount-cell"><%= row.amount === null ? '—' : formatCurrency(row.amount) %></td><td class="amount-cell"><%= formatCurrency(row.detailTotal) %></td><td><%= row.unresolved ? 'Sans détail' : (row.mismatch ? 'Écart à vérifier' : 'Correspondance') %></td></tr><% }) %>
      </tbody></table></div>
    <% } else { %><p class="page-note">Aucune ligne de total boutique distincte détectée.</p><% } %>
  </article>
</section>

<section class="panel-card page-table-card">
  <div class="panel-header"><div><h2>Lignes de la période</h2><p><%= records.length %> ligne(s), y compris les lignes incomplètes.</p></div></div>
  <% if (records.length) { %>
    <div class="table-wrap"><table class="transactions-table">
      <thead><tr><th>DATE</th><th>INTITULÉ D’ORIGINE</th><th>CATÉGORIE</th><th>QUANTITÉ / UNITÉ</th><th class="amount-cell">MONTANT</th><th>TYPE / ÉTAT</th></tr></thead>
      <tbody><% records.forEach((row) => { %><tr>
        <td class="date-cell"><%= row.date ? formatDate(row.date) : '—' %></td>
        <td><strong><%= row.title || 'Intitulé absent' %></strong><small><%= row.sheetName %>, ligne <%= row.rowNumber %></small></td>
        <td><%= row.type === 'grocery' ? 'Boutique' : row.categoryName %><% if (row.categoryRaw && row.type === 'expense') { %><small>Source : <%= row.categoryRaw %></small><% } %></td>
        <td><%= row.quantityKnown ? row.quantity : '—' %> <%= row.unit || '' %><% if (row.unitPriceKnown) { %><small>PU : <%= formatCurrency(row.unitPrice) %></small><% } %></td>
        <td class="amount-cell"><strong><%= row.amount === null ? '—' : formatCurrency(row.amount) %></strong></td>
        <td><%= row.type === 'grocery' ? 'Marchandise boutique' : 'Dépense ordinaire' %>
          <% if (row.duplicateSource) { %><small>Doublon : <%= row.duplicateSource === 'base' ? 'déjà en base' : 'dans le fichier' %></small><% } %>
          <% if (!row.valid) { %><small>Incomplète</small><% } %>
          <% if (row.issues.length) { %><small><%= row.issues.join(' · ') %></small><% } %>
        </td>
      </tr><% }) %></tbody>
    </table></div>
  <% } else { %><div class="empty-state"><strong>Aucune ligne candidate dans cette période.</strong></div><% } %>
</section>

<% if (excludedRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Lignes antérieures à la période suivie</h2><p><%= excludedRows.length %> ligne(s) datée(s) avant le 1er janvier 2026 ; elles ne seront pas importées.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>DATE</th><th>INTITULÉ</th><th>FEUILLE</th><th class="amount-cell">MONTANT</th></tr></thead>
      <tbody><% excludedRows.forEach((row) => { %><tr><td><%= row.date || '—' %></td><td><%= row.title || '—' %></td><td><%= row.sheetName %></td><td class="amount-cell"><%= row.amount === null ? '—' : formatCurrency(row.amount) %></td></tr><% }) %></tbody>
    </table></div>
  </section>
<% } %>

<% if (rawRows.length) { %>
  <section class="panel-card page-table-card">
    <div class="panel-header"><div><h2>Lignes non interprétées</h2><p><%= rawRows.length %> ligne(s) avec structure non reconnue. Leur contenu brut est conservé ici, sans être importé.</p></div></div>
    <div class="table-wrap"><table class="transactions-table"><thead><tr><th>FEUILLE</th><th>LIGNE</th><th>CONTENU SOURCE ET CORRECTION</th></tr></thead><tbody>
      <% rawRows.forEach((row) => { %>
        <% const suggestedTitle = row.values.find((value) => /[a-z]/i.test(value)) || ''; %>
        <% const suggestedAmount = row.values.find((value) => /^\s*[\d\s,.]+(?:\s*FCFA)?\s*$/i.test(value)); %>
        <tr><td><%= row.sheetName %></td><td><%= row.row %></td><td><strong><%= row.values.join(' | ') %></strong><small><%= row.reason || 'Ligne non interprétée.' %></small></td></tr>
        <tr><td colspan="3"><form method="POST" action="/import/preview/<%= previewBatch.id %>/correct" class="inline-form">
          <input type="hidden" name="sheetName" value="<%= row.sheetName %>" />
          <input type="hidden" name="rowNumber" value="<%= row.row %>" />
          <label>Type
            <select name="kind"><option value="expense">Dépense</option><option value="income">Recette</option><option value="total">Total / sous-total</option><option value="header">En-tête / ignorer comme donnée</option></select>
          </label>
          <label>Désignation / libellé<input name="title" value="<%= suggestedTitle %>" /></label>
          <label>Catégorie<input name="categoryName" /></label>
          <label>Source recette<input name="source" /></label>
          <label>Mois (AAAA-MM)<input name="monthKey" inputmode="numeric" placeholder="2026-01" /></label>
          <label>Montant<input name="amount" inputmode="decimal" value="<%= suggestedAmount || '' %>" /></label>
          <button class="button button-subtle" type="submit">Enregistrer la correction</button>
        </form></td></tr>
      <% }) %>
    </tbody></table></div>
  </section>
<% } %>
<% if (ignoredRows.some((row) => !row.values)) { %><p class="page-note">Les feuilles de synthèse ou les lignes de titre sans données n’ont pas été importées comme dépenses.</p><% } %>

<%- include('partials/page-end') %>
