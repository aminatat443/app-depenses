<div class="excel-native-actions" data-excel-native-actions
     data-excel-url="<%= exportUrl %>"
     data-excel-caption="<%= caption || 'Classeur Excel · Dépenses maison' %>">
  <button class="button button-subtle" type="button" data-excel-preview>
    <span aria-hidden="true">◫</span> Aperçu Excel
  </button>
  <button class="button button-subtle" type="button" data-excel-share>
    <span aria-hidden="true">↗</span> Partager sur WhatsApp
  </button>
</div>
