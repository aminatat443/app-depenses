<div class="global-search-wrap">
  <form class="search-form" id="global-search" method="GET" action="/history" role="search" aria-controls="global-search-results" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4 4"/></svg>
    <input type="search" name="search" placeholder="<%= isDashboard ? 'Rechercher dans l’application' : 'Rechercher sur cette page' %>" aria-label="<%= isDashboard ? 'Rechercher dans l’application' : 'Rechercher sur cette page' %>" autocomplete="off" />
  </form>
  <div class="global-search-results" id="global-search-results" role="region" aria-label="<%= isDashboard ? 'Résultats de recherche dans l’application' : 'Résultats de recherche sur cette page' %>" aria-live="polite" hidden></div>
</div>
