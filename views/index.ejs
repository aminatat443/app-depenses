<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7f2" />
    <title>Vue d’ensemble · Maison</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="app-shell">
    <div class="app-frame">
      <aside class="sidebar" aria-label="Navigation principale">
        <a class="brand" href="/" aria-label="Maison, vue d’ensemble">
          <span class="brand-mark">M</span>
          <span class="brand-copy"><strong>Maison</strong><small>GESTION FAMILIALE</small></span>
        </a>

        <div class="household-switch">
          <span class="avatar">M</span>
          <span><strong>Notre foyer</strong><small>Compte familial</small></span>
          <span class="switch-chevron" aria-hidden="true">⌄</span>
        </div>

        <nav class="side-nav">
          <span class="nav-caption">ESPACE MAISON</span>
          <a class="nav-item is-active" href="/" aria-current="page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>
            <span>Vue d’ensemble</span>
          </a>
          <a class="nav-item" href="/expenses">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5z"/><path d="M8 9h8M8 13h8M8 17h4"/></svg>
            <span>Dépenses du mois</span>
          </a>
          <a class="nav-item" href="/groceries">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16l-1 12H5L4 8Z"/><path d="M9 8a3 3 0 0 1 6 0M8 12v4M12 12v4M16 12v4"/></svg>
            <span>Compte boutique</span>
          </a>
          <a class="nav-item" href="/history">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h15M15 4l4 3-4 3M20 17H5m4-3-4 3 4 3"/></svg>
            <span>Historique</span>
          </a>
          <a class="nav-item" href="/monthly">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/></svg>
            <span>Bilans &amp; statistiques</span>
          </a>

          <span class="nav-caption nav-caption-secondary">OUTILS</span>
          <a class="nav-item" href="/import">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m-4 4 4-4 4 4"/><path d="M5 14v5h14v-5"/></svg>
            <span>Importation Excel</span>
          </a>
          <a class="nav-item" href="/export">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m4-4-4 4-4-4"/><path d="M5 16v4h14v-4"/></svg>
            <span>Exportation Excel</span>
          </a>
          <a class="nav-item" href="/backup">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.8 7.7 7 10 4.2-2.3 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
            <span>Sauvegardes</span>
          </a>
        </nav>

        <div class="sidebar-bottom">
          <a class="nav-item" href="/categories">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.5.9l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.5-.9l-1.7.7-1.4-2.4 1.4-1.1a7 7 0 0 1 0-1.8l-1.4-1.1 1.4-2.4 1.7.7a8 8 0 0 1 1.5-.9l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.5.9l1.7-.7 1.4 2.4-1.4 1.1a7 7 0 0 1 0 1.7Z"/></svg>
            <span>Paramètres · catégories</span>
          </a>
          <div class="sidebar-status"><span class="status-dot"></span><span>Données enregistrées localement</span></div>
        </div>
      </aside>

      <main class="main-area">
        <header class="page-header">
          <div class="page-heading">
            <div class="eyebrow">MAISON / VUE D’ENSEMBLE</div>
            <h1>Les dépenses du foyer, en clair.</h1>
            <p>Un aperçu simple des achats et dépenses de la maison.</p>
          </div>
          <div class="header-tools">
            <form class="search-form" id="dashboard-search" role="search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4 4"/></svg>
              <input type="search" name="search" placeholder="Rechercher une opération" aria-label="Rechercher une opération" />
            </form>
            <a class="button button-outline export-button" href="/export">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4"/><path d="M5 16v4h14v-4"/></svg>
              Exporter
            </a>
            <form class="month-picker" method="GET" action="/">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M8 3v5m8-5v5M4 10h16"/></svg>
              <label class="sr-only" for="month-select">Mois affiché</label>
              <input id="month-select" type="month" name="month" value="<%= dashboard.monthKey %>" />
              <input type="hidden" name="period" value="<%= dashboard.period %>" />
            </form>
            <button class="button button-primary add-button" type="button" data-modal-template="expense-create">
              <span aria-hidden="true">＋</span> Ajouter une dépense
            </button>
          </div>
        </header>

        <section class="summary-grid" aria-label="Résumé du mois">
          <article class="metric-card metric-featured">
            <div class="metric-heading"><span>Dépenses totales du mois</span><span class="metric-icon">↗</span></div>
            <div class="metric-value"><%= formatCurrency(dashboard.currentMonthTotal) %></div>
            <div class="metric-foot"><span><%= dashboard.monthLabel %></span><span class="trend-note <%= dashboard.monthDelta > 0 ? 'is-up' : 'is-down' %>"><%= dashboard.monthDelta > 0 ? '↑' : '↓' %> <%= formatCurrency(Math.abs(dashboard.monthDelta)) %> vs mois précédent</span></div>
          </article>
          <article class="metric-card">
            <div class="metric-heading"><span>Compte boutique</span><span class="metric-icon icon-soft-green">⌂</span></div>
            <div class="metric-value"><%= formatCurrency(dashboard.groceryTotal) %></div>
            <div class="metric-foot"><span>Achats et ravitaillements</span><a href="/groceries">Voir le compte <span aria-hidden="true">→</span></a></div>
          </article>
          <article class="metric-card">
            <div class="metric-heading"><span>Autres dépenses</span><span class="metric-icon icon-soft-coral">↗</span></div>
            <div class="metric-value"><%= formatCurrency(dashboard.otherExpenses) %></div>
            <div class="metric-foot"><span>Factures, services, autres</span><a href="/expenses">Voir le détail <span aria-hidden="true">→</span></a></div>
          </article>
          <article class="metric-card">
            <div class="metric-heading"><span>Opérations du mois</span><span class="metric-icon icon-soft-blue">≋</span></div>
            <div class="metric-value"><%= dashboard.operationCount %></div>
            <div class="metric-foot"><span>Sur la période sélectionnée</span><a href="/history">Consulter l’historique <span aria-hidden="true">→</span></a></div>
          </article>
        </section>

        <section class="middle-grid">
          <article class="panel-card chart-panel">
            <div class="panel-header">
              <div><h2>Évolution des dépenses</h2><p>Compte boutique et dépenses ordinaires</p></div>
              <div class="period-switch" aria-label="Période du graphique">
                <% [3, 6, 12].forEach((period) => { %>
                  <a class="<%= dashboard.period === period ? 'is-selected' : '' %>" href="/?month=<%= dashboard.monthKey %>&period=<%= period %>" <%= dashboard.period === period ? 'aria-current="true"' : '' %>><%= period %>M</a>
                <% }) %>
              </div>
            </div>
            <div class="chart-legend">
              <span><i class="legend-dot legend-grocery"></i>Compte boutique</span>
              <span><i class="legend-dot legend-expense"></i>Autres dépenses</span>
              <span class="chart-unit">Montants en FCFA</span>
            </div>
            <div class="bar-chart" role="img" aria-label="Comparaison mensuelle des dépenses sur <%= dashboard.period %> mois">
              <div class="chart-scale" aria-hidden="true">
                <% if (dashboard.trendMax <= 1) { %>
                  <span>—</span><span>—</span><span>—</span><span>0</span>
                <% } else { %>
                  <span><%= formatCurrency(dashboard.trendMax) %></span><span><%= formatCurrency(dashboard.trendMax * 0.66) %></span><span><%= formatCurrency(dashboard.trendMax * 0.33) %></span><span>0</span>
                <% } %>
              </div>
              <div class="chart-plot" style="--chart-columns:<%= dashboard.period %>">
                <div class="chart-grid-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <% dashboard.trend.forEach((item) => { %>
                  <div class="chart-month">
                    <div class="bar-pair">
                      <span class="chart-bar bar-grocery" title="Compte boutique : <%= formatCurrency(item.groceries) %>" style="--bar-height:<%= item.groceries ? Math.max(2, (item.groceries / dashboard.trendMax) * 100) : 0 %>%"></span>
                      <span class="chart-bar bar-expense" title="Autres dépenses : <%= formatCurrency(item.expenses) %>" style="--bar-height:<%= item.expenses ? Math.max(2, (item.expenses / dashboard.trendMax) * 100) : 0 %>%"></span>
                    </div>
                    <span class="chart-month-label"><%= item.label %></span>
                  </div>
                <% }) %>
              </div>
            </div>
            <div class="chart-foot">
              <span>Les montants sont calculés à partir des opérations enregistrées.</span>
              <a href="/monthly?year=<%= dashboard.year %>">Voir le bilan <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="panel-card category-panel">
            <div class="panel-header">
              <div><h2>Par catégorie</h2><p>Dépenses ordinaires du mois</p></div>
              <a class="quiet-link" href="/categories" aria-label="Gérer les catégories">···</a>
            </div>
            <% if (dashboard.categoryBreakdown.length) { %>
              <div class="category-list">
                <% dashboard.categoryBreakdown.forEach((item) => { %>
                  <div class="category-item">
                    <div class="category-label"><span class="category-name"><i class="category-swatch" style="--category-color:<%= item.color || '#147967' %>"></i><%= item.name %></span><strong><%= formatCurrency(item.total) %></strong></div>
                    <div class="category-track"><span style="--category-color:<%= item.color || '#147967' %>;--category-width:<%= (item.total / dashboard.categoryTotal) * 100 %>%"></span></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state"><span class="empty-icon">⌁</span><strong>Aucune dépense par catégorie</strong><span>Les opérations apparaîtront ici.</span></div>
            <% } %>
            <div class="panel-total"><span>Total des dépenses ordinaires</span><strong><%= formatCurrency(dashboard.categoryTotal) %></strong></div>
          </article>

          <article class="panel-card grocery-panel">
            <div class="panel-header">
              <div><h2>Compte boutique</h2><p><%= dashboard.groceryCount %> ravitaillement<%= dashboard.groceryCount > 1 ? 's' : '' %> ce mois-ci</p></div>
              <a class="quiet-link" href="/groceries" aria-label="Ouvrir le compte boutique">→</a>
            </div>
            <div class="grocery-total">
              <span>Total du mois</span>
              <strong><%= formatCurrency(dashboard.groceryTotal) %></strong>
            </div>
            <% if (dashboard.groceryItems.length) { %>
              <ul class="grocery-list">
                <% dashboard.groceryItems.slice(0, 3).forEach((item) => { %>
                  <li><span><strong><%= item.item_name %></strong><small><%= formatDate(item.purchase_date) %><% if (item.quantity) { %> · <%= item.quantity %> <%= item.unit || '' %><% } %></small></span><strong><%= formatCurrency(item.total_amount) %></strong></li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="empty-state empty-compact"><strong>Aucun ravitaillement ce mois-ci</strong><span>Ajoutez un achat pour le suivre ici.</span></div>
            <% } %>
            <a class="button button-subtle button-full" href="/groceries">Ouvrir le compte boutique</a>
          </article>
        </section>

        <section class="bottom-grid">
          <article class="panel-card transactions-panel">
            <div class="panel-header">
              <div><h2>Dernières opérations</h2><p>Activité enregistrée pour <%= dashboard.monthLabel %></p></div>
              <a class="text-link" href="/history">Voir l’historique <span aria-hidden="true">→</span></a>
            </div>
            <% if (dashboard.recentOperations.length) { %>
              <div class="table-wrap">
                <table class="transactions-table">
                  <thead><tr><th>OPÉRATION</th><th>CATÉGORIE</th><th>DATE</th><th class="amount-cell">MONTANT</th><th></th></tr></thead>
                  <tbody>
                    <% dashboard.recentOperations.forEach((item) => { %>
                      <tr>
                        <td><span class="transaction-name"><i class="transaction-icon <%= item.type === 'grocery' ? 'transaction-grocery' : '' %>"><%= item.type === 'grocery' ? '⌂' : '↗' %></i><strong><%= item.title %></strong></span></td>
                        <td><span class="category-pill"><%= item.category %></span></td>
                        <td class="date-cell"><%= formatDate(item.date) %></td>
                        <td class="amount-cell"><strong><%= formatCurrency(item.amount) %></strong></td>
                        <td class="detail-cell"><a href="/history?search=<%= encodeURIComponent(item.title) %>" aria-label="Voir <%= item.title %>">→</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state table-empty"><span class="empty-icon">⌁</span><strong>Aucune opération pour ce mois</strong><span>Ajoutez une dépense ou un ravitaillement pour commencer.</span></div>
            <% } %>
          </article>

          <article class="panel-card tools-panel">
            <div class="panel-header"><div><h2>Vos outils de suivi</h2><p>Gérez vos données en toute simplicité.</p></div></div>
            <a class="tool-link" href="/import">
              <span class="tool-icon tool-import"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m-4 4 4-4 4 4"/><path d="M5 14v5h14v-5"/></svg></span>
              <span><strong>Importer un fichier Excel</strong><small>Prévisualisez avant d’ajouter vos données</small></span><b>→</b>
            </a>
            <a class="tool-link" href="/export">
              <span class="tool-icon tool-report"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5z"/><path d="M14 3v5h5M8 13h8M8 17h8"/></svg></span>
              <span><strong>Bilans et exportations</strong><small>Consultez ou exportez vos bilans annuels</small></span><b>→</b>
            </a>
            <a class="tool-link" href="/backup">
              <span class="tool-icon tool-backup"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.8 7.7 7 10 4.2-2.3 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
              <span><strong>Sauvegardes</strong><small>Protégez et restaurez les données du foyer</small></span><b>→</b>
            </a>
            <div class="tools-note"><span class="status-dot"></span>Votre historique reste accessible depuis le menu.</div>
          </article>
        </section>

        <footer class="page-footer"><span><i class="status-dot"></i> Données synchronisées avec la base locale</span><span>Maison · Gestion des dépenses familiales · FCFA</span></footer>
      </main>
    </div>

    <template id="expense-create"><%- include('partials/expense-form', { categories }) %></template>
    <div id="app-modal" class="app-modal" aria-hidden="true">
      <div class="modal-backdrop" data-close-modal="true"></div>
      <div class="modal-panel" role="dialog" aria-modal="true" aria-label="Page de l’application">
        <button class="close-modal" aria-label="Fermer">×</button>
        <div id="modal-content"></div>
      </div>
    </div>

    <script src="/app.js" defer></script>
  </body>
</html>
