<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Vue d’ensemble · Maison</title>
    <script src="/theme.js"></script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="app-shell" data-page="overview">
    <div class="app-frame">
      <%- include('partials/sidebar', { activePage: 'overview' }) %>

      <main class="main-area">
        <header class="page-header">
          <div class="page-heading">
            <div class="eyebrow">MAISON / VUE D’ENSEMBLE</div>
            <h1>Vue d’ensemble</h1>
            <p>La situation financière de <%= dashboard.monthLabel %>, en un coup d’œil.</p>
          </div>
          <div class="header-tools">
            <%- include('partials/global-search') %>
            <a class="button button-outline export-button" href="/export">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4"/><path d="M5 16v4h14v-4"/></svg>
              Exporter
            </a>
            <form class="month-picker" method="GET" action="/" data-live-filter data-live-filter-root=".main-area">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M8 3v5m8-5v5M4 10h16"/></svg>
              <label class="sr-only" for="month-select">Mois affiché</label>
              <input id="month-select" type="month" name="month" value="<%= dashboard.monthKey %>" />
              <input type="hidden" name="period" value="<%= dashboard.period %>" />
            </form>
            <button class="button button-primary add-button" type="button" data-modal-template="expense-create">
              <span aria-hidden="true">＋</span> Ajouter une dépense
            </button>
          </div>
        </header>

        <section class="summary-grid dashboard-kpis" aria-label="Indicateurs financiers du mois">
          <a class="metric-card metric-income dashboard-metric-link" href="/income?month=<%= finance.monthKey %>" aria-label="Voir les revenus du mois">
            <div class="metric-heading"><span>Revenus encaissés</span><span class="metric-icon">↗</span></div>
            <div class="metric-value"><%= formatCurrency(finance.incomeTotal) %></div>
            <div class="metric-foot"><span>Hors épargne protégée</span><span class="metric-card-action">Détail →</span></div>
          </a>
          <a class="metric-card metric-expense dashboard-metric-link" href="/expenses?month=<%= finance.monthKey %>" aria-label="Voir les dépenses du mois">
            <div class="metric-heading"><span>Dépenses du mois</span><span class="metric-icon">↘</span></div>
            <div class="metric-value"><%= formatCurrency(finance.totalExpenses) %></div>
            <div class="metric-foot"><span><%= dashboard.operationCount %> opérations</span><span class="metric-card-action">Détail →</span></div>
          </a>
          <a class="metric-card metric-balance dashboard-metric-link" href="/monthly?year=<%= finance.monthKey.slice(0, 4) %>&amp;month=<%= Number(finance.monthKey.slice(5, 7)) %>" aria-label="Voir le bilan et le solde du mois">
            <div class="metric-heading"><span>Solde disponible</span><span class="metric-icon">◈</span></div>
            <div class="metric-value <%= finance.closingBalance < 0 ? 'is-negative' : '' %>"><%= formatCurrency(finance.closingBalance) %></div>
            <div class="metric-foot"><span>Report précédent : <%= formatCurrency(finance.openingBalance) %></span><span class="metric-card-action">Voir le bilan →</span></div>
          </a>
          <a class="metric-card metric-rent dashboard-metric-link" href="/rents?month=<%= finance.monthKey %>" aria-label="Suivre les loyers du mois">
            <div class="metric-heading"><span>Loyers encaissés</span><span class="metric-icon">⌂</span></div>
            <div class="metric-value"><%= formatCurrency(finance.rentReceived) %></div>
            <div class="metric-foot"><span>Sur <%= formatCurrency(finance.rentExpected) %> attendus</span><span class="metric-card-action">Suivi →</span></div>
          </a>
          <a class="metric-card metric-arrears dashboard-metric-link" href="/rents?month=<%= finance.monthKey %>" aria-label="Voir les loyers impayés du mois">
            <div class="metric-heading"><span>Loyers impayés</span><span class="metric-icon">!</span></div>
            <div class="metric-value"><%= formatCurrency(finance.rentOutstanding) %></div>
            <div class="metric-foot"><span>Reste à percevoir</span><span class="metric-card-action">Voir les loyers →</span></div>
          </a>
          <a class="metric-card metric-savings dashboard-metric-link" href="/savings" aria-label="Consulter l’épargne protégée">
            <div class="metric-heading"><span>Épargne pension père</span><span class="metric-icon">▣</span></div>
            <div class="metric-value"><%= formatCurrency(finance.protectedSavingsBalance) %></div>
            <div class="metric-foot"><span>Réserve protégée · hors solde</span><span class="metric-card-action">Historique →</span></div>
          </a>
        </section>

        <section class="middle-grid">
          <article class="panel-card chart-panel">
            <div class="panel-header">
              <div><h2>Revenus et dépenses</h2><p>Montants réellement enregistrés sur la période</p></div>
              <div class="period-switch" aria-label="Période du graphique">
                <% [3, 6, 12].forEach((period) => { %>
                  <a class="<%= dashboard.period === period ? 'is-selected' : '' %>" href="/?month=<%= dashboard.monthKey %>&period=<%= period %>" <%= dashboard.period === period ? 'aria-current="true"' : '' %>><%= period %>M</a>
                <% }) %>
              </div>
            </div>
            <div class="chart-legend">
              <span><i class="legend-dot legend-income"></i>Revenus encaissés</span>
              <span><i class="legend-dot legend-expense"></i>Dépenses enregistrées</span>
              <span class="chart-unit">Montants en FCFA</span>
            </div>
            <div class="bar-chart" role="img" aria-label="Comparaison mensuelle des revenus et dépenses sur <%= dashboard.period %> mois">
              <div class="chart-scale" aria-hidden="true">
                <% if (dashboard.financialTrendMax <= 1) { %>
                  <span>—</span><span>—</span><span>—</span><span>0</span>
                <% } else { %>
                  <span><%= formatCurrency(dashboard.financialTrendMax) %></span><span><%= formatCurrency(dashboard.financialTrendMax * 0.66) %></span><span><%= formatCurrency(dashboard.financialTrendMax * 0.33) %></span><span>0</span>
                <% } %>
              </div>
              <div class="chart-plot" style="--chart-columns:<%= dashboard.period %>">
                <div class="chart-grid-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <% dashboard.financialTrend.forEach((item) => { %>
                  <div class="chart-month">
                    <div class="bar-pair">
                      <span class="chart-bar bar-income" title="Revenus encaissés : <%= formatCurrency(item.income) %>" style="--bar-height:<%= item.income ? Math.max(2, (item.income / dashboard.financialTrendMax) * 100) : 0 %>%"></span>
                      <span class="chart-bar bar-expense" title="Dépenses enregistrées : <%= formatCurrency(item.expenses) %>" style="--bar-height:<%= item.expenses ? Math.max(2, (item.expenses / dashboard.financialTrendMax) * 100) : 0 %>%"></span>
                    </div>
                    <span class="chart-month-label"><%= item.label %></span>
                  </div>
                <% }) %>
              </div>
            </div>
            <div class="chart-foot">
              <span>L’épargne pension père reste exclue des revenus disponibles.</span>
              <a href="/monthly?year=<%= dashboard.year %>">Voir le bilan <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="panel-card category-panel">
            <div class="panel-header">
              <div><h2>Par catégorie</h2><p>Dépenses ordinaires du mois</p></div>
              <a class="quiet-link" href="/categories" aria-label="Gérer les catégories">···</a>
            </div>
            <% if (dashboard.categoryBreakdown.length) { %>
              <div class="category-list">
                <% dashboard.categoryBreakdown.forEach((item) => { %>
                  <div class="category-item">
                    <div class="category-label"><span class="category-name"><i class="category-swatch" style="--category-color:<%= item.color || '#147967' %>"></i><%= item.name %></span><strong><%= formatCurrency(item.total) %></strong></div>
                    <div class="category-track"><span style="--category-color:<%= item.color || '#147967' %>;--category-width:<%= (item.total / dashboard.categoryTotal) * 100 %>%"></span></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state"><span class="empty-icon">⌁</span><strong>Aucune dépense par catégorie</strong><span>Les opérations apparaîtront ici.</span></div>
            <% } %>
            <div class="panel-total"><span>Total des dépenses ordinaires</span><strong><%= formatCurrency(dashboard.categoryTotal) %></strong></div>
            <details class="source-breakdown">
              <summary><span>Revenus par source</span><span>Voir la répartition</span></summary>
              <% const incomeSources = [
                { label: 'Pape', amount: finance.papeAmount },
                { label: 'Pension du père', amount: finance.pensionAmount },
                { label: 'Loyers encaissés', amount: finance.rentReceived },
                { label: 'Autres revenus', amount: finance.otherIncome },
              ].filter((source) => Number(source.amount) > 0); %>
              <% if (incomeSources.length) { %>
                <div class="source-breakdown-list">
                  <% incomeSources.forEach((source) => { %>
                    <div class="source-breakdown-item">
                      <div><span><%= source.label %></span><strong><%= formatCurrency(source.amount) %></strong></div>
                      <span class="source-breakdown-track"><i style="--source-width:<%= (source.amount / finance.incomeTotal) * 100 %>%"></i></span>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="source-breakdown-empty">Aucun revenu encaissé pour ce mois.</p>
              <% } %>
            </details>
          </article>

          <article class="panel-card balance-panel">
            <div class="panel-header">
              <div><h2>Évolution du solde</h2><p>Après dépenses, épargne suivie séparément</p></div>
              <a class="quiet-link" href="/monthly?year=<%= dashboard.year %>" aria-label="Consulter le bilan annuel">→</a>
            </div>
            <% if (dashboard.financialTrend.some((item) => item.closingBalance !== 0)) { %>
              <div class="balance-chart" role="img" aria-label="Solde disponible en fin de mois sur <%= dashboard.period %> mois">
                <% dashboard.financialTrend.forEach((item) => { %>
                  <div class="balance-month">
                    <span class="balance-value"><%= formatCurrency(item.closingBalance) %></span>
                    <span class="balance-track" title="<%= item.label %> : <%= formatCurrency(item.closingBalance) %>"><i class="<%= item.closingBalance < 0 ? 'is-negative' : '' %>" style="--balance-height:<%= item.closingBalance ? Math.max(3, (Math.abs(item.closingBalance) / dashboard.balanceTrendMaxAbs) * 100) : 2 %>%"></i></span>
                    <span class="chart-month-label"><%= item.label %></span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state empty-compact"><strong>Aucun solde disponible sur cette période</strong><span>Les soldes apparaîtront à mesure que les opérations seront enregistrées.</span></div>
            <% } %>
            <div class="balance-note">Les reports de mois précédents sont inclus.</div>
          </article>
        </section>

        <section class="bottom-grid">
          <article class="panel-card transactions-panel">
            <div class="panel-header">
              <div><h2>Dernières opérations</h2><p>Activité enregistrée pour <%= dashboard.monthLabel %></p></div>
              <a class="text-link" href="/history">Voir l’historique <span aria-hidden="true">→</span></a>
            </div>
            <% if (dashboard.recentOperations.length) { %>
              <div class="table-wrap" id="dashboard-recent-table">
                <table class="transactions-table">
                  <thead><tr><th>OPÉRATION</th><th>CATÉGORIE</th><th>DATE</th><th class="amount-cell">MONTANT</th><th></th></tr></thead>
                  <tbody>
                    <% dashboard.recentOperations.forEach((item) => { %>
                      <% const operationHref = item.type === 'grocery'
                        ? `/groceries?month=${encodeURIComponent(item.month)}&search=${encodeURIComponent(item.title)}&open=grocery-details-${item.id}`
                        : item.funding_source === 'protected_savings'
                          ? item.source_id
                            ? `/savings?open=savings-details-${item.source_id}`
                            : '/savings'
                        : `/expenses?month=${encodeURIComponent(item.month)}&search=${encodeURIComponent(item.title)}&open=expense-details-${item.id}`; %>
                      <tr data-dashboard-operation data-operation-key="<%= item.type %>-<%= item.id %>" data-operation-search="<%= item.search_text %>" data-row-href="<%= operationHref %>" tabindex="0" aria-label="Ouvrir l’opération <%= item.title %>">
                        <td><span class="transaction-name"><i class="transaction-icon <%= item.type === 'grocery' ? 'transaction-grocery' : '' %>"><%= item.type === 'grocery' ? '⌂' : '↗' %></i><strong><%= item.title %></strong></span><% if (item.funding_source === 'protected_savings') { %><small class="page-note">Épargne protégée</small><% } %></td>
                        <td><span class="category-pill"><%= item.category %></span><% if (item.funding_source === 'protected_savings') { %><small class="page-note">Hors solde courant</small><% } %></td>
                        <td class="date-cell"><%= formatDate(item.date) %></td>
                        <td class="amount-cell"><strong><%= formatCurrency(item.amount) %></strong></td>
                        <td class="detail-cell"><a href="<%= operationHref %>" aria-label="Ouvrir l’opération <%= item.title %>" title="Aperçu"><%- include('partials/action-icon', { icon: 'view' }) %></a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="empty-state table-empty" id="dashboard-search-empty" hidden><strong>Aucune opération récente ne correspond</strong><span>Les autres résultats apparaissent sous la recherche.</span></div>
            <% } else { %>
              <div class="empty-state table-empty"><span class="empty-icon">⌁</span><strong>Aucune opération pour ce mois</strong><span>Ajoutez une dépense ou un ravitaillement pour commencer.</span></div>
            <% } %>
          </article>

          <article class="panel-card tools-panel">
            <div class="panel-header"><div><h2>Vos outils de suivi</h2><p>Gérez vos données en toute simplicité.</p></div></div>
            <a class="tool-link" href="/import">
              <span class="tool-icon tool-import"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m-4 4 4-4 4 4"/><path d="M5 14v5h14v-5"/></svg></span>
              <span><strong>Importer un fichier Excel</strong><small>Prévisualisez avant d’ajouter vos données</small></span><b>→</b>
            </a>
            <a class="tool-link" href="/export">
              <span class="tool-icon tool-report"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5z"/><path d="M14 3v5h5M8 13h8M8 17h8"/></svg></span>
              <span><strong>Bilans et exportations</strong><small>Consultez ou exportez vos bilans annuels</small></span><b>→</b>
            </a>
            <a class="tool-link" href="/backup">
              <span class="tool-icon tool-backup"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.8 7.7 7 10 4.2-2.3 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
              <span><strong>Sauvegardes</strong><small>Protégez et restaurez les données du foyer</small></span><b>→</b>
            </a>
            <div class="tools-note"><span class="status-dot"></span>Votre historique reste accessible depuis le menu.</div>
          </article>
        </section>

        <footer class="page-footer"><span><i class="status-dot"></i> Données synchronisées avec la base locale</span><span>Maison · Gestion des dépenses familiales · FCFA</span></footer>
      </main>
    </div>

    <template id="expense-create"><%- include('partials/expense-form', { categories, expense: null, returnTo: '/expenses' }) %></template>
    <div id="app-modal" class="app-modal" aria-hidden="true">
      <div class="modal-backdrop" data-close-modal="true"></div>
      <div class="modal-panel" role="dialog" aria-modal="true" aria-label="Action de l’application" tabindex="-1">
        <button class="close-modal" type="button" aria-label="Fermer" data-close-modal>×</button>
        <div id="modal-content"></div>
      </div>
    </div>

    <script src="/app.js" defer></script>
  </body>
</html>
