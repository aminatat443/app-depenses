<%- include('partials/page-start', {
  pageTitle: 'Loyers & paiements',
  pageDescription: 'Générez les loyers attendus et enregistrez les paiements reçus.',
  activePage: 'rents'
}) %>

<section class="page-toolbar">
  <div><h2>Suivi des loyers · <%= monthKey %></h2><p>Les loyers attendus sont distincts des montants encaissés.</p></div>
  <div class="page-toolbar-actions">
    <form method="POST" action="/rents/generate">
      <input type="hidden" name="month_key" value="<%= monthKey %>" />
      <button class="button button-primary" type="submit">Générer les loyers attendus</button>
    </form>
    <% if (obligations.some((row) => Number(row.expected_amount) > Number(row.amount_paid))) { %>
      <button class="button button-subtle" type="button" data-modal-template="rent-mark-selected-paid" data-rent-selected-trigger disabled>Marquer la sélection comme payée</button>
      <button class="button button-subtle" type="button" data-modal-template="rent-mark-all-paid">Marquer tous les loyers comme payés</button>
    <% } %>
  </div>
</section>

<section class="panel-card page-filter-card">
  <form method="GET" action="/rents" class="page-filter-form" data-live-filter data-live-filter-root=".page-content">
    <label>Mois<input type="month" name="month" value="<%= monthKey %>" required /></label>
    <button class="button button-subtle" type="submit">Afficher</button>
  </form>
  <% if (generated !== undefined) { %><p class="page-note"><%= generated %> nouvelle<%= Number(generated) === 1 ? '' : 's' %> obligation<%= Number(generated) === 1 ? '' : 's' %> créée<%= Number(generated) === 1 ? '' : 's' %>.</p><% } %>
  <% if (marked !== undefined) { %><p class="page-note"><%= Number(marked) ? `${marked} loyer${Number(marked) === 1 ? '' : 's'} marqué${Number(marked) === 1 ? '' : 's'} comme payé${Number(marked) === 1 ? '' : 's'}.` : 'Aucun loyer restant à payer.' %></p><% } %>
</section>

<section class="summary-grid report-summary">
  <article class="metric-card"><div class="metric-heading"><span>Loyers attendus</span></div><div class="metric-value"><%= formatCurrency(totals.expected) %></div></article>
  <article class="metric-card"><div class="metric-heading"><span>Loyers encaissés</span></div><div class="metric-value"><%= formatCurrency(totals.received) %></div></article>
  <article class="metric-card metric-featured"><div class="metric-heading"><span>Reste à payer</span></div><div class="metric-value"><%= formatCurrency(Math.max(0, totals.expected - totals.received)) %></div></article>
</section>

<section class="panel-card page-table-card">
  <div class="panel-header"><div><h2>Échéances du mois</h2><p><%= obligations.length %> obligation<%= obligations.length === 1 ? '' : 's' %> générée<%= obligations.length === 1 ? '' : 's' %>.</p></div><a class="text-link" href="/tenants">Gérer les locataires →</a></div>
  <% if (obligations.length) { %>
    <div class="table-wrap"><table class="transactions-table">
      <thead><tr><th class="rent-select-cell"><label class="rent-select-control"><input type="checkbox" data-rent-select-all aria-label="Sélectionner tous les loyers impayés" /><span class="sr-only">Sélectionner tous les loyers impayés</span></label></th><th>LOGEMENT</th><th>LOCATAIRE</th><th class="amount-cell">ATTENDU</th><th class="amount-cell">PAYÉ</th><th class="amount-cell">RESTANT</th><th>STATUT</th><th>ACTION</th></tr></thead>
      <tbody><% obligations.forEach((row) => {
        const remaining = Math.max(0, Number(row.expected_amount) - Number(row.amount_paid));
      %>
        <tr <% if (remaining > 0) { %>data-modal-template="rent-payment-<%= row.id %>" aria-label="Enregistrer un paiement de loyer pour <%= row.first_name %> <%= row.last_name %>"<% } else { %>data-row-href="/history?type=rent&amp;month=<%= encodeURIComponent(monthKey) %>&amp;search=<%= encodeURIComponent(row.first_name + ' ' + row.last_name) %>" aria-label="Voir les paiements de loyer de <%= row.first_name %> <%= row.last_name %>"<% } %> tabindex="0">
          <td class="rent-select-cell"><% if (remaining > 0) { %><label class="rent-select-control"><input type="checkbox" value="<%= row.id %>" data-rent-payment-select aria-label="Sélectionner le loyer de <%= row.first_name %> <%= row.last_name %>" /><span class="sr-only">Sélectionner le loyer</span></label><% } else { %>—<% } %></td>
          <td><%= row.floor %> · <%= row.unit_label %></td>
          <td><strong><%= row.first_name %> <%= row.last_name %></strong></td>
          <td class="amount-cell"><%= formatCurrency(row.expected_amount) %></td>
          <td class="amount-cell"><%= formatCurrency(row.amount_paid) %></td>
          <td class="amount-cell"><strong><%= formatCurrency(remaining) %></strong></td>
          <td><span class="category-pill"><%= row.status %></span></td>
          <td><% if (remaining > 0) { %><button class="table-action" type="button" data-modal-template="rent-payment-<%= row.id %>">Enregistrer un paiement</button><% } else { %>—<% } %></td>
        </tr>
        <% if (remaining > 0) { %>
          <template id="rent-payment-<%= row.id %>">
            <div class="modal-heading"><span class="eyebrow">PAIEMENT DE LOYER</span><h2><%= row.first_name %> <%= row.last_name %></h2><p>Reste à payer : <strong><%= formatCurrency(remaining) %></strong></p></div>
            <form method="POST" action="/rents/<%= row.id %>/payments">
              <div class="form-grid">
                <label>Montant reçu (FCFA)<input type="number" name="amount" min="1" max="<%= remaining %>" step="1" value="<%= remaining %>" required /></label>
                <label>Date du paiement (facultative)<input type="date" name="payment_date" /></label>
                <label>Mode de paiement<select name="payment_method"><option value="">Non précisé</option><% paymentMethods.forEach((method) => { %><option value="<%= method %>"><%= method %></option><% }) %></select></label>
                <label>Commentaire<input name="comment" /></label>
              </div>
              <div class="modal-actions"><button type="button" class="secondary-btn" data-close-modal>Annuler</button><button type="submit" class="primary-btn">Enregistrer le paiement</button></div>
            </form>
          </template>
        <% } %>
      <% }) %></tbody>
    </table></div>
  <% } else { %><div class="empty-state table-empty"><strong>Aucune échéance générée pour ce mois</strong><span>Utilisez « Générer les loyers attendus » après avoir enregistré les locataires actifs.</span></div><% } %>
</section>
<template id="rent-mark-all-paid">
  <div class="modal-heading"><span class="eyebrow">PAIEMENTS DU MOIS</span><h2>Marquer tous les loyers comme payés</h2><p>Le solde restant de chaque loyer de <%= monthKey %> sera enregistré comme paiement.</p></div>
  <form method="POST" action="/rents/mark-all-paid">
    <input type="hidden" name="month_key" value="<%= monthKey %>" />
    <div class="form-grid">
      <label>Date du paiement (facultative)<input type="date" name="payment_date" /></label>
    </div>
    <div class="modal-actions"><button type="button" class="secondary-btn" data-close-modal data-modal-initial-focus>Annuler</button><button type="submit" class="primary-btn">Marquer comme payé</button></div>
  </form>
</template>
<template id="rent-mark-selected-paid">
  <div class="modal-heading"><span class="eyebrow">PAIEMENTS DU MOIS</span><h2>Marquer la sélection comme payée</h2><p><span data-rent-selected-count>0</span> <span data-rent-selected-label>loyers sélectionnés</span> pour <%= monthKey %>. Chaque solde restant sera enregistré comme paiement.</p></div>
  <form method="POST" action="/rents/mark-selected-paid">
    <input type="hidden" name="month_key" value="<%= monthKey %>" />
    <div data-rent-selected-inputs></div>
    <div class="form-grid">
      <label>Date du paiement (facultative)<input type="date" name="payment_date" /></label>
    </div>
    <div class="modal-actions"><button type="button" class="secondary-btn" data-close-modal data-modal-initial-focus>Annuler</button><button type="submit" class="primary-btn">Marquer comme payé</button></div>
  </form>
</template>
<% paymentDetails.forEach((payment) => { %>
  <template id="rent-payment-details-<%= payment.id %>">
    <div class="modal-heading"><span class="eyebrow">APERÇU DU LOYER ENCAISSÉ</span><h2><%= payment.first_name %> <%= payment.last_name %></h2><p><%= payment.floor %> · <%= payment.unit_label %> · <%= payment.month_key %></p></div>
    <dl class="detail-list">
      <div><dt>Montant reçu</dt><dd><%= formatCurrency(payment.amount) %></dd></div>
      <div><dt>Date du paiement</dt><dd><%= formatDate(payment.payment_date) %></dd></div>
      <div><dt>Loyer attendu</dt><dd><%= formatCurrency(payment.expected_amount) %></dd></div>
      <div><dt>Mode de paiement</dt><dd><%= payment.payment_method || 'Non précisé' %></dd></div>
      <div><dt>Commentaire</dt><dd><%= payment.comment || '—' %></dd></div>
    </dl>
  </template>
<% }) %>
<%- include('partials/page-end') %>
