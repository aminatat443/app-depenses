<%- include('partials/page-start', {
  pageTitle: 'Paramètres des catégories',
  pageDescription: 'Organisez les dépenses ordinaires avec vos propres catégories.',
  activePage: 'settings'
}) %>

<section class="page-toolbar">
  <div><h2>Catégories de dépenses</h2><p><%= categories.length %> catégorie<%= categories.length > 1 ? 's' : '' %> disponible<%= categories.length > 1 ? 's' : '' %>.</p></div>
  <button class="button button-primary" type="button" data-modal-template="category-create"><span aria-hidden="true">＋</span> Créer une catégorie</button>
</section>

<section class="panel-card page-table-card">
  <div class="panel-header"><div><h2>Catégories existantes</h2><p>Une catégorie de remplacement est conservée pour les opérations déjà enregistrées.</p></div></div>
  <% if (categories.length) { %>
    <div class="category-settings-list">
      <% categories.forEach((category) => { %>
        <div class="category-settings-row">
          <span class="category-settings-name"><i class="category-swatch" style="--category-color:<%= category.color || '#147967' %>"></i><strong><%= category.name %></strong></span>
          <div class="table-actions">
            <% if (category.type !== 'boutique') { %><button class="table-action icon-action" type="button" aria-label="Modifier la catégorie <%= category.name %>" title="Modifier" data-modal-template="category-edit-<%= category.id %>"><%- include('partials/action-icon', { icon: 'edit' }) %></button><% } %>
            <% if (category.type === 'boutique' || category.name === 'Autres dépenses') { %>
              <span class="category-default-note"><%= category.type === 'boutique' ? 'Compte boutique' : 'Catégorie de remplacement' %></span>
            <% } else { %>
              <button class="table-action icon-action danger" type="button" aria-label="Supprimer la catégorie <%= category.name %>" title="Supprimer" data-modal-confirm="/categories/<%= category.id %>/delete" data-modal-title="Supprimer cette catégorie ?" data-modal-message="Les dépenses associées seront reclassées dans « Autres dépenses »." data-modal-submit="Supprimer" data-modal-danger="true"><%- include('partials/action-icon', { icon: 'delete' }) %></button>
            <% } %>
          </div>
          <% if (category.type !== 'boutique') { %>
            <template id="category-edit-<%= category.id %>">
              <div class="modal-heading"><span class="eyebrow">PERSONNALISATION</span><h2>Modifier la catégorie</h2></div>
              <form method="POST" action="/categories/<%= category.id %>/update">
                <label>Nom<input type="text" name="name" value="<%= category.name %>" maxlength="100" required /></label>
                <label>Couleur<input type="color" name="color" value="<%= category.color || '#147967' %>" /></label>
                <div class="modal-actions"><button type="button" class="secondary-btn" data-close-modal>Annuler</button><button type="submit" class="primary-btn">Enregistrer</button></div>
              </form>
            </template>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state table-empty"><strong>Aucune catégorie disponible</strong></div>
  <% } %>
</section>

<template id="category-create"><%- include('partials/category-form') %></template>
<%- include('partials/page-end') %>
