PORT=3000

# Use DATABASE_URL for hosted PostgreSQL, or configure the PG* variables below.
# Local defaults: Unix socket, current OS user, and database "app_depenses".
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=app_depenses
PGUSER=
PGPASSWORD=

# Single administrator account (required to run `npm run create-admin`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudflare R2 optional configuration for backup exports.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
